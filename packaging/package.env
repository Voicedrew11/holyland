# What players see the port called (docs/port/LAUNCHER.md, "Releases"; the launcher's own copy is
# launcher/product.h). Read by packaging/*.sh, the installer (packaging/windows/installer.iss) and
# tools/release.sh; one KEY=VALUE a line. NAME is for file names, DISPLAY_NAME for people.
NAME=DarkerReality
DISPLAY_NAME="Holyland"
APP_ID=holyland
# The Inno Setup AppId: how Windows tells an upgrade of Holyland from another program. Never change it.
INNO_APP_ID=F9E51BCA-D768-400E-B7F7-3BDDDA5000A8
# A per-user install, under %LOCALAPPDATA%\Programs: no administrator needed, as Verdite's ports
INNO_PRIVILEGES=lowest
