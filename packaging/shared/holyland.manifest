<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The Windows application manifest of kf4.exe and the launcher (holyland.rc.in puts it in each .exe).
     - activeCodePage UTF-8: the narrow C functions (fopen, stat, mkdir, getenv, the game's own file code) take
       UTF-8 paths, so a data folder under a user name like "José" opens. Windows 10 1903 and newer; older
       Windows ignores it and keeps the ANSI code page.
     - longPathAware: paths over 260 characters, where Windows' LongPathsEnabled policy is on.
     - asInvoker: never asks for administrator (Windows guesses that from names with "update" or "setup" in them
       when an .exe has no manifest).
     - supportedOS Windows 10/11: Windows does not run the program under its compatibility shims for old programs.
     Display scaling (DPI) is left to SDL. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Holyland" version="1.0.0.0"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
