+// PS2X_VU1_VERIFY=1 (testing): run every VU1 microprogram through the
+// reference interpreter too, on copies of VU1 memory, and compare the
+// resulting registers, VU1 data memory and XGKICK output.
+void PS2Runtime::runVu1Verified(bool resume, uint32_t startPC, uint32_t top, uint32_t itop)
+{
+    static const bool s_verify = []()
+    {
+        const char *env = std::getenv("PS2X_VU1_VERIFY");
+        return env && *env && *env != '0';
+    }();
+    if (!s_verify)
+    {
+        if (resume)
+            m_vu1.resume(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE, m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                         m_gs, &m_memory, top, itop, 65536);
+        else
+            m_vu1.execute(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE, m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                          m_gs, &m_memory, startPC, top, itop, 65536);
+        return;
+    }
+
+    static_assert(sizeof(VU1State) == sizeof(VU1StateRef));
+    static VU1InterpreterRef s_ref(VU1InterpreterRef::Unit::VU1);
+    static bool s_started = false;
+    static uint64_t s_runs = 0, s_mismatches = 0;
+    static std::vector<uint8_t> s_refData, s_refKicks, s_kicks;
+    if (!s_started)
+    {
+        std::memcpy(&s_ref.state(), &m_vu1.state(), sizeof(VU1State));
+        s_started = true;
+    }
+    s_ref.state().dBitEnabled = m_vu1.state().dBitEnabled;
+    s_ref.state().tBitEnabled = m_vu1.state().tBitEnabled;
+    s_refData.assign(m_memory.getVU1Data(), m_memory.getVU1Data() + PS2_VU1_DATA_SIZE);
+    s_ref.kickCapture.clear();
+    VU1State before{};
+    std::memcpy(&before, &m_vu1.state(), sizeof(VU1State));
+    if (resume)
+        s_ref.resume(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE, s_refData.data(), PS2_VU1_DATA_SIZE,
+                     m_gs, &m_memory, top, itop, 65536);
+    else
+        s_ref.execute(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE, s_refData.data(), PS2_VU1_DATA_SIZE,
+                      m_gs, &m_memory, startPC, top, itop, 65536);
+
+    s_kicks.clear();
+    m_vu1.debugKickCapture = &s_kicks;
+    if (resume)
+        m_vu1.resume(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE, m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                     m_gs, &m_memory, top, itop, 65536);
+    else
+        m_vu1.execute(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE, m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+                      m_gs, &m_memory, startPC, top, itop, 65536);
+    m_vu1.debugKickCapture = nullptr;
+
+    ++s_runs;
+    const bool stateOk = std::memcmp(&s_ref.state(), &m_vu1.state(), sizeof(VU1State)) == 0;
+    const bool dataOk = std::memcmp(s_refData.data(), m_memory.getVU1Data(), PS2_VU1_DATA_SIZE) == 0;
+    const bool kicksOk = s_ref.kickCapture == s_kicks;
+    if (!(stateOk && dataOk && kicksOk))
+    {
+        if (++s_mismatches <= 20)
+        {
+            const VU1State &a = m_vu1.state();
+            const VU1StateRef &b = s_ref.state();
+            std::fprintf(stderr, "[vu1verify] MISMATCH run %llu (%s pc=0x%x start=0x%x): state=%d data=%d kicks=%d (%zu vs ref %zu bytes) cycles %llu vs ref %llu\n",
+                         static_cast<unsigned long long>(s_runs), resume ? "resume" : "execute", before.pc, startPC,
+                         stateOk, dataOk, kicksOk, s_kicks.size(), s_ref.kickCapture.size(),
+                         static_cast<unsigned long long>(a.cycles), static_cast<unsigned long long>(b.cycles));
+            for (int r = 0; r < 32; ++r)
+                for (int c = 0; c < 4; ++c)
+                    if (std::memcmp(&a.vf[r][c], &b.vf[r][c], 4) != 0)
+                        std::fprintf(stderr, "  vf%d[%d] %g vs ref %g\n", r, c, a.vf[r][c], b.vf[r][c]);
+            for (int r = 0; r < 16; ++r)
+                if (a.vi[r] != b.vi[r])
+                    std::fprintf(stderr, "  vi%d %d vs ref %d\n", r, a.vi[r], b.vi[r]);
+            std::fprintf(stderr, "  mac %x/%x status %x/%x clip %x/%x q %g/%g p %g/%g pc %x/%x\n",
+                         a.mac, b.mac, a.status, b.status, a.clip, b.clip, a.q, b.q, a.p, b.p, a.pc, b.pc);
+        }
+        // Continue from the live interpreter's state.
+        std::memcpy(&s_ref.state(), &m_vu1.state(), sizeof(VU1State));
+    }
+    if ((s_runs % 20000u) == 0u)
+        std::fprintf(stderr, "[vu1verify] %llu runs, %llu mismatches\n",
+                     static_cast<unsigned long long>(s_runs), static_cast<unsigned long long>(s_mismatches));
+}
