diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index ff2dca1..2b08d95 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -401,6 +401,27 @@ add_library(ps2_runtime STATIC
     src/lib/games_database.cpp
 )
 
+# RelWithDebInfo defaults to /Ob1 on MSVC. The VU interpreter's small helpers
+# are hot enough to benefit from optimization-driven inlining across the three
+# interpreter sources. Their flag normalization requires strict floating-point
+# evaluation in every configuration; generated EE translation is unchanged.
+if(MSVC)
+    set_property(SOURCE
+        src/lib/vu/ps2_vu1_core.cpp
+        src/lib/vu/ps2_vu1_upper.cpp
+        src/lib/vu/ps2_vu1_lower.cpp
+        APPEND PROPERTY COMPILE_OPTIONS
+        "/fp:strict"
+        "$<$<CONFIG:RelWithDebInfo>:/Ob2>" "$<$<CONFIG:RelWithDebInfo>:/GL>")
+elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
+    set_property(SOURCE
+        src/lib/vu/ps2_vu1_core.cpp
+        src/lib/vu/ps2_vu1_upper.cpp
+        src/lib/vu/ps2_vu1_lower.cpp
+        APPEND PROPERTY COMPILE_OPTIONS
+        "-fno-fast-math" "-frounding-math" "-ffp-contract=off")
+endif()
+
 if(PS2X_ENABLE_RUNTIME_LOGS)
     target_compile_definitions(ps2_runtime PUBLIC
         PS2_RUNTIME_LOGS=1
@@ -467,6 +488,10 @@ else()
     )
 endif()
 
+if(MSVC)
+    target_link_options(ps2EntryRunner PRIVATE "$<$<CONFIG:RelWithDebInfo>:/LTCG>")
+endif()
+
 if(PS2X_ENABLE_RUNNER_UNITY_BUILD)
     set_target_properties(ps2EntryRunner PROPERTIES
         UNITY_BUILD ON
