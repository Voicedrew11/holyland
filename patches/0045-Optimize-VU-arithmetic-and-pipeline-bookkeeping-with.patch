+    // The opcode classification is invariant across execution. Preserve the
+    // distinct normal/special outer-product operations in separate entries.
+    constexpr auto kFmacDecode = []
+    {
+        std::array<FmacDecode, 192> table{};
+        for (uint32_t code = 0; code < 64u; ++code)
+            table[code] = decodeFmacCode(code, false);
+        for (uint32_t code = 0; code < 128u; ++code)
+            table[64u + code] = decodeFmacCode(code, true);
+        return table;
+    }();
+
+    FmacDecode decodeFmac(uint32_t upper)
+    {
+        const uint32_t op = upper & 0x3Fu;
+        const uint32_t index = op >= 0x3Cu ? 64u + ((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+        return kFmacDecode[index];
+    }
+
+    // Spread Z/S/U/O into MAC's four lane groups before selecting a lane.
+    constexpr auto kFmacFlagScatter = []
+    {
+        std::array<uint16_t, 16> table{};
+        for (uint32_t flags = 0u; flags < table.size(); ++flags)
+            table[flags] = static_cast<uint16_t>((flags & 1u) | ((flags & 2u) << 3) |
+                ((flags & 4u) << 6) | ((flags & 8u) << 9));
+        return table;
+    }();
+
     bool isProductSum(FmacOp op)
     {
         return op == FmacOp::MAdd || op == FmacOp::MSub || op == FmacOp::OuterMSub;
     }
 
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+    constexpr auto kFmacLaneByteMask = []
+    {
+        std::array<uint32_t, 16> masks{};
+        for (uint32_t dest = 0u; dest < masks.size(); ++dest)
+            for (uint32_t lane = 0u; lane < 4u; ++lane)
+                if ((dest & laneForComponent(lane)) != 0u)
+                    masks[dest] |= 0xFFu << (lane * 8u);
+        return masks;
+    }();
+
+    bool classifySingleFmacLanes(const float *result, uint8_t dest, FmacOp op, uint8_t laneFlags[4])
+    {
+        const __m128i bits = _mm_loadu_si128(reinterpret_cast<const __m128i *>(result));
+        const __m128i magnitude = _mm_and_si128(bits, _mm_set1_epi32(0x7FFFFFFF));
+        const __m128i exponent = _mm_and_si128(bits, _mm_set1_epi32(0x7F800000));
+        const __m128i zero = _mm_cmpeq_epi32(magnitude, _mm_setzero_si128());
+        const __m128i unusual = _mm_or_si128(_mm_cmpeq_epi32(exponent, _mm_setzero_si128()),
+            _mm_or_si128(_mm_cmpeq_epi32(exponent, _mm_set1_epi32(0x7F800000)),
+                         _mm_cmpeq_epi32(magnitude, _mm_set1_epi32(0x7F7FFFFF))));
+        __m128i qualifying = _mm_andnot_si128(unusual, _mm_set1_epi32(-1));
+        const bool sum = op == FmacOp::Add || op == FmacOp::Sub;
+        if (sum)
+            qualifying = _mm_or_si128(qualifying, zero);
+        const uint32_t required = ((dest & 8u) >> 3u) | ((dest & 4u) >> 1u) |
+                                  ((dest & 2u) << 1u) | ((dest & 1u) << 3u);
+        if ((static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(qualifying))) & required) != required)
+            return false;
+        __m128i flags = _mm_and_si128(_mm_srli_epi32(bits, 30), _mm_set1_epi32(2));
+        if (sum)
+            flags = _mm_or_si128(flags, _mm_and_si128(zero, _mm_set1_epi32(1)));
+        flags = _mm_packs_epi32(flags, _mm_setzero_si128());
+        flags = _mm_packus_epi16(flags, _mm_setzero_si128());
+        const uint32_t packed = static_cast<uint32_t>(_mm_cvtsi128_si32(flags)) & kFmacLaneByteMask[dest & 15u];
+        std::memcpy(laneFlags, &packed, sizeof(packed));
+        return true;
+    }
+
+    std::array<uint8_t, 2> classifyFmacDoubleLanes(__m128d values)
+    {
+        const __m128d magnitude = _mm_andnot_pd(_mm_set1_pd(-0.0), values);
+        const uint32_t negative = static_cast<uint32_t>(_mm_movemask_pd(values));
+        const uint32_t zero = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmpeq_pd(magnitude, _mm_setzero_pd())));
+        const uint32_t overflow = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmpgt_pd(magnitude,
+            _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::max())))));
+        const uint32_t underflow = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmplt_pd(magnitude,
+            _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::min()))))) & ~zero;
+        return {static_cast<uint8_t>((negative & 1u) * 2u | (zero & 1u) | (overflow & 1u) * 8u | (underflow & 1u) * 5u),
+            static_cast<uint8_t>((negative >> 1u) * 2u | (zero >> 1u) | (overflow >> 1u) * 8u | (underflow >> 1u) * 5u)};
+    }
+
+    uint32_t packFmacLaneFlags(__m128i flags, uint8_t dest)
+    {
+        flags = _mm_packs_epi32(flags, _mm_setzero_si128());
+        flags = _mm_packus_epi16(flags, _mm_setzero_si128());
+        return static_cast<uint32_t>(_mm_cvtsi128_si32(flags)) & kFmacLaneByteMask[dest & 15u];
+    }
+
+    bool classifyProductSumFmacFast(__m128 a, __m128 b, const float *result, uint8_t dest,
+                                    uint8_t laneFlags[4], uint32_t &productSticky)
+    {
+        const __m128i absoluteMask = _mm_set1_epi32(0x7FFFFFFF);
+        const __m128i exponentMask = _mm_set1_epi32(0x7F800000);
+        const __m128i productBits = _mm_castps_si128(_mm_mul_ps(a, b));
+        const __m128i productMagnitude = _mm_and_si128(productBits, absoluteMask);
+        const __m128i productExponent = _mm_and_si128(productBits, exponentMask);
+        const __m128i exactProductZero = _mm_or_si128(
+            _mm_cmpeq_epi32(_mm_and_si128(_mm_castps_si128(a), absoluteMask), _mm_setzero_si128()),
+            _mm_cmpeq_epi32(_mm_and_si128(_mm_castps_si128(b), absoluteMask), _mm_setzero_si128()));
+        const __m128i unusualProduct = _mm_or_si128(_mm_cmpeq_epi32(productExponent, _mm_setzero_si128()),
+            _mm_or_si128(_mm_cmpeq_epi32(productExponent, exponentMask),
+                         _mm_cmpeq_epi32(productMagnitude, _mm_set1_epi32(0x7F7FFFFF))));
+        const __m128i ordinaryProduct = _mm_andnot_si128(unusualProduct, _mm_set1_epi32(-1));
+        const __m128i resultBits = _mm_loadu_si128(reinterpret_cast<const __m128i *>(result));
+        const __m128i resultMagnitude = _mm_and_si128(resultBits, absoluteMask);
+        const __m128i resultExponent = _mm_and_si128(resultBits, exponentMask);
+        // Normal result binades 2..253 keep a margin from FLT_MIN and FLT_MAX.
+        const __m128i resultRange = _mm_and_si128(
+            _mm_cmpgt_epi32(resultExponent, _mm_set1_epi32(0x00800000)),
+            _mm_cmpgt_epi32(_mm_set1_epi32(0x7F000000), resultExponent));
+        // |r| >= 4 product ULPs bounds product truncation below |r|/4.
+        // The sum contributes < one result ULP. Thus the exact result has
+        // r's sign and stays strictly within the normal finite float range.
+        const __m128i minimumResultExponent = _mm_sub_epi32(productExponent, _mm_set1_epi32(21u << 23u));
+        const __m128i resultScale = _mm_or_si128(_mm_cmpgt_epi32(resultExponent, minimumResultExponent),
+                                                _mm_cmpeq_epi32(resultExponent, minimumResultExponent));
+        const __m128i qualifying = _mm_or_si128(exactProductZero,
+            _mm_and_si128(ordinaryProduct, _mm_and_si128(resultRange, resultScale)));
+        const uint32_t required = ((dest & 8u) >> 3u) | ((dest & 4u) >> 1u) |
+                                  ((dest & 2u) << 1u) | ((dest & 1u) << 3u);
+        if ((static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(qualifying))) & required) != required)
+            return false;
+        const __m128i signFlag = _mm_set1_epi32(2);
+        const __m128i zeroFlag = _mm_set1_epi32(1);
+        const __m128i productFlags = _mm_or_si128(_mm_and_si128(_mm_srli_epi32(productBits, 30), signFlag),
+                                                 _mm_and_si128(exactProductZero, zeroFlag));
+        const uint32_t products = packFmacLaneFlags(productFlags, dest);
+        productSticky = (products | (products >> 8u) | (products >> 16u) | (products >> 24u)) & 15u;
+        const __m128i resultFlags = _mm_or_si128(_mm_and_si128(_mm_srli_epi32(resultBits, 30), signFlag),
+            _mm_and_si128(_mm_cmpeq_epi32(resultMagnitude, _mm_setzero_si128()), zeroFlag));
+        const uint32_t results = packFmacLaneFlags(resultFlags, dest);
+        std::memcpy(laneFlags, &results, sizeof(results));
+        return true;
+    }
+
+    void normalizeProductSumLanes(const FmacDecode &fmac, const float *vs, const float *vt, const float *acc,
+                                   float q, float i, float *result, uint8_t dest,
+                                   uint8_t laneFlags[4], uint32_t &productSticky)
+    {
+        __m128 a = _mm_loadu_ps(vs);
+        __m128 b = _mm_setzero_ps();
+        switch (fmac.source)
+        {
+        case FmacSource::Broadcast: b = _mm_set1_ps(vt[fmac.broadcast]); break;
+        case FmacSource::Q: b = _mm_set1_ps(q); break;
+        case FmacSource::I: b = _mm_set1_ps(i); break;
+        case FmacSource::Full: b = _mm_loadu_ps(vt); break;
+        case FmacSource::Cross:
+            a = _mm_shuffle_ps(a, a, _MM_SHUFFLE(3, 0, 2, 1));
+            b = _mm_loadu_ps(vt);
+            b = _mm_shuffle_ps(b, b, _MM_SHUFFLE(3, 1, 0, 2));
+            break;
+        }
+        __m128 accum = _mm_loadu_ps(acc);
+        // OuterMSub forces w to +0 independently of its product; keep its
+        // existing exact path. All other product sums use the bounded shortcut
+        // only when every selected lane qualifies, retaining full fallback.
+        if (fmac.op != FmacOp::OuterMSub &&
+            classifyProductSumFmacFast(a, b, result, dest, laneFlags, productSticky))
+            return;
+        for (uint32_t pair = 0u; pair < 2u; ++pair)
+        {
+            const __m128d product = _mm_mul_pd(_mm_cvtps_pd(a), _mm_cvtps_pd(b));
+            __m128d exact = fmac.op == FmacOp::MAdd ? _mm_add_pd(_mm_cvtps_pd(accum), product)
+                                                   : _mm_sub_pd(_mm_cvtps_pd(accum), product);
+            if (fmac.op == FmacOp::OuterMSub && pair == 1u)
+                exact = _mm_unpacklo_pd(exact, _mm_setzero_pd());
+            const auto productFlags = classifyFmacDoubleLanes(product);
+            const auto resultFlags = classifyFmacDoubleLanes(exact);
+            for (uint32_t local = 0u; local < 2u; ++local)
+            {
+                const uint32_t lane = pair * 2u + local;
+                laneFlags[lane] = 0u;
+                if ((dest & laneForComponent(lane)) == 0u)
+                    continue;
+                productSticky |= productFlags[local];
+                const uint8_t flags = resultFlags[local];
+                laneFlags[lane] = flags;
+                if ((flags & 9u) != 0u)
+                {
+                    const uint32_t bits = ((flags & 2u) != 0u ? 0x80000000u : 0u) |
+                                          ((flags & 8u) != 0u ? 0x7F7FFFFFu : 0u);
+                    std::memcpy(&result[lane], &bits, sizeof(bits));
+                }
+            }
+            a = _mm_movehl_ps(a, a);
+            b = _mm_movehl_ps(b, b);
+            accum = _mm_movehl_ps(accum, accum);
+        }
+    }
+#endif
+
     inline int nextSlot(uint32_t &bits)
     {
         const int slot = std::countr_zero(bits);
         bits &= bits - 1u;
         return slot;
     }
+
+    template <typename Real>
+    Real fmacMagnitude(Real value)
+    {
+        // IEEE binary64 sign/absolute classification is a bit operation. A
+        // platform with a wider long double retains the standard fallback.
+        if constexpr (sizeof(Real) == sizeof(uint64_t) && std::numeric_limits<Real>::is_iec559 &&
+                      std::numeric_limits<Real>::digits == 53)
+            return std::bit_cast<Real>(std::bit_cast<uint64_t>(value) & 0x7FFFFFFFFFFFFFFFull);
+        else
+            return std::fabs(value);
+    }
+
+    template <typename Real>
+    bool fmacNegative(Real value)
+    {
+        if constexpr (sizeof(Real) == sizeof(uint64_t) && std::numeric_limits<Real>::is_iec559 &&
+                      std::numeric_limits<Real>::digits == 53)
+            return (std::bit_cast<uint64_t>(value) >> 63) != 0u;
+        else
+            return std::signbit(value);
+    }
 }
 
