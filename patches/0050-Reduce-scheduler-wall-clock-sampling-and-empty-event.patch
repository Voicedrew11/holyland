+        uint64_t target = wallClockTarget(wallNow);
+        const uint64_t eventBoundary = m_nextEligibleDeadlineCycle.load(std::memory_order_acquire);
+        if (eventBoundary != 0u)
+            target = std::min(target, std::max(m_eeCycle, eventBoundary));
+        if (target > m_eeCycle)
+        {
+            // Reconciling clock time alone does not require a dispatcher
