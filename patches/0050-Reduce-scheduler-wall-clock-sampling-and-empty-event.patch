             for (const ScheduledEvent &item : m_deadlines)
             {
                 if (item.event.type == EeEventType::VBlankStart && vblankStartHeld())
@@ -2307,7 +2349,9 @@ void EeScheduler::retireVBlankHandoff(int threadId)
 
 void EeScheduler::expireVBlankHandoffs()
 {
