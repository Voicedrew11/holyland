+    // Idle pacing and IOP accounting may consume host time in this pass.
+    // Refresh only after all of it, before a pre-entry checkpoint reuses time.
+    wallClockSampleOwner = this;
+    wallClockSample = std::chrono::steady_clock::now();
 }
 
 void EeScheduler::processDueDeadlines()
 {
     const auto creditNow = std::chrono::steady_clock::now();
+    wallClockSampleOwner = this;
+    wallClockSample = creditNow;
+    expireVBlankHandoffs();
+    const auto nextHost = m_nextHostDeadlineTicks.load(std::memory_order_acquire);
+    const bool elapsedQuantum = creditNow >= m_nextWallClockCheck;
+    if (!elapsedQuantum && m_nextEligibleDeadlineCycle.load(std::memory_order_acquire) == 0u &&
+        (nextHost == std::numeric_limits<int64_t>::max() ||
+         creditNow.time_since_epoch().count() < nextHost))
+        return;
     for (;;)
     {
         expireVBlankHandoffs();
@@ -1943,7 +1977,14 @@ void EeScheduler::processDueDeadlines()
             // The hardware clock has a reset-anchored wall-time floor. Native
             // SDK work advances that floor independently of field publication;
             // already accounted guest cycles are never added a second time.
-            uint64_t creditTarget = wallClockTarget(creditNow);
+            // Outside the quantum, reconcile only for a wall-due event
+            // whose original cycle boundary has not yet been reached.
+            bool physicalBoundaryNeedsCredit = false;
+            for (const ScheduledEvent &item : m_deadlines)
+                physicalBoundaryNeedsCredit |= item.hostDeadline <= now && item.deadlineCycle > m_eeCycle &&
+                    !(item.event.type == EeEventType::VBlankStart && vblankStartHeld());
+            uint64_t creditTarget = elapsedQuantum || physicalBoundaryNeedsCredit
+                ? wallClockTarget(creditNow) : m_eeCycle;
             for (const ScheduledEvent &item : m_deadlines)
             {
                 if (item.hostDeadline <= now &&
@@ -1963,7 +2004,8 @@ void EeScheduler::processDueDeadlines()
                     return;
