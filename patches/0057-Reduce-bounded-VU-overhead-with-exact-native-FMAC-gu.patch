+            if (tryApplyNormalFmacDest(m_state.acc, result, dest)) return;
+        if constexpr (nativeProductSum)
+            if (tryApplyProductSumFmacDest(m_state.acc, result, dest, static_cast<uint8_t>(nativeFmac.source), nativeFmac.broadcast)) return;
