+            m_unit == Unit::VU1 && memory != nullptr && vuCode == memory->getVU1Code() &&
+            m_cachedVuCode == vuCode && m_cachedMemory == memory &&
+            m_cachedCodeSize == codeSize && codeSize == 16384u && m_state.pc < codeSize &&
+            (m_state.pc & 7u) == 0u &&
+            m_cachedCodeGeneration == memory->getVU1CodeGeneration())
+        {
+            // Pass the same cached descriptor without its dynamic flags/read
+            // slots lookup. Reserved entry PCs return zero from the catalog
+            // and take the unchanged decoder/reserved-instruction path below.
+            const int native = trySpecializedBlock(m_decodedCodeCache[m_state.pc / 8u],
+                vuCode, codeSize, vuData, dataSize, gs, memory, budgetEnd, m_cachedCodeGeneration);
+            if (native == 2) { programEnded = true; break; }
+            if (native == 3) break;
+            if (native == 1) continue;
+        }
+#endif
