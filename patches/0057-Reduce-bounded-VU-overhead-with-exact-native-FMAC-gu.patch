         const DecodedInstructionPair &decoded = hostJob && m_jobPendingPairValid
             ? m_jobPendingPair : getDecodedInstructionPairForPc(vuCode, codeSize, memory, m_state.pc);
         if (decoded.has(DecodedUpperReserved) || decoded.has(DecodedLowerReserved))
