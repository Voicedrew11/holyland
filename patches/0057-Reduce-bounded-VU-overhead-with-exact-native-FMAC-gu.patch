+    # X: constexpr ADD/SUB/MUL admission; keep the full exact helper cold.
+    upper_function = upper_function.replace('applyFmacDest(', 'nativeApplyFmacDest(')
+    upper_function = upper_function.replace('applyFmacDestAcc(', 'nativeApplyFmacDestAcc(')
+    native_fast = """
+    constexpr uint32_t normalOpcode = instr & 0x3fu;
+    constexpr uint32_t nativeIndex = normalOpcode >= 0x3cu ? 64u + ((instr & 3u) | ((instr >> 4u) & 0x7cu)) : normalOpcode;
+    constexpr FmacDecode nativeFmac = kFmacDecode[nativeIndex];
+    constexpr bool nativeNormalOp = nativeFmac.op == FmacOp::Add || nativeFmac.op == FmacOp::Sub || nativeFmac.op == FmacOp::Mul;
+    constexpr bool nativeProductSum = nativeFmac.op == FmacOp::MAdd || nativeFmac.op == FmacOp::MSub;
+    const auto nativeApplyFmacDest = [this, nativeFmac](float *dst, float *result, uint8_t dest)
+    {
+        if constexpr (nativeNormalOp)
+            if (tryApplyNormalFmacDest(dst, result, dest)) return;
+        if constexpr (nativeProductSum)
