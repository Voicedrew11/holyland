+        }
+        ~VuFpEnvironment() noexcept
+        {
+            if (m_active) _mm_setcsr(m_previousMxcsr);
+        }
+#else
         std::fenv_t m_previous{};
         bool m_saved = false;
         int m_previousRounding = -1;
@@ -2089,6 +2224,7 @@ namespace
             if (m_saved) std::fesetenv(&m_previous);
             else if (m_previousRounding != -1) std::fesetround(m_previousRounding);
         }
+#endif
     };
 }
 
