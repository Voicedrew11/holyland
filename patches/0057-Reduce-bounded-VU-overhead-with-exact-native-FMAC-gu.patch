+
+// This helper is called only by native ADD/SUB/MUL bodies. Arithmetic
+// has already run with the existing strict FP contract. For a selected normal
+// result below FLT_MAX, the exact old normalizer preserves its bits and reports
+// only S. All zero, subnormal, max, and nonfinite boundaries retain that helper.
+VU_NATIVE_INLINE bool VU1Interpreter::tryApplyNormalFmacDest(float *dst, float *result, uint8_t dest)
+{
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+    const __m128 values = _mm_loadu_ps(result);
+    const __m128i magnitude = _mm_and_si128(_mm_castps_si128(values), _mm_set1_epi32(0x7FFFFFFF));
+    const __m128i exponent = _mm_and_si128(magnitude, _mm_set1_epi32(0x7F800000));
+    const __m128i invalid = _mm_or_si128(
+        _mm_or_si128(_mm_cmpeq_epi32(exponent, _mm_setzero_si128()),
+                     _mm_cmpeq_epi32(exponent, _mm_set1_epi32(0x7F800000))),
+        _mm_cmpeq_epi32(magnitude, _mm_set1_epi32(0x7F7FFFFF)));
+    const uint32_t invalidLanes = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(invalid)));
+    const auto reversed = [](uint32_t bits)
+    {
+        return ((bits & 1u) << 3u) | ((bits & 2u) << 1u) |
+               ((bits & 4u) >> 1u) | ((bits & 8u) >> 3u);
+    };
+    if ((reversed(invalidLanes) & dest) != 0u)
+    {
+        return false;
+    }
+
+    if (dest != 0u)
+    {
+        const uint32_t signLanes = static_cast<uint32_t>(_mm_movemask_ps(values));
+        const uint32_t selectedSigns = reversed(signLanes) & dest;
+        // Keep the exact same eager +4-cycle entry/slot and STATUS transform.
+        // This is a direct sign transpose, not deferred/lazy flag state.
+        queueFmacFlags(selectedSigns << 4u, selectedSigns != 0u ? 2u : 0u, 0u);
+    }
+    applyDest(dst, result, dest);
+    return true;
+#else
+    (void)dst; (void)result; (void)dest;
+    return false;
+#endif
+}
+
+// Native MADD/MSUB only: reuse the unchanged bounded product/sum guard.
+// Qualifying lanes have only S/Z for current flags and product sticky flags.
+// Transpose them directly into the same eager +4-cycle MAC/STATUS entry;
+// all unusual/cancellation/outer-product cases retain the exact normalizer.
+VU_NATIVE_INLINE bool VU1Interpreter::tryApplyProductSumFmacDest(float *dst, float *result, uint8_t dest,
+                                               uint8_t source, uint8_t broadcast)
+{
+#if (defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)) && FLT_EVAL_METHOD == 0
+    // This bounded shortcut classifies only sign/zero well inside the normal
+    // float range. Its error margin does not depend on long-double precision.
+    // Boundary/cancellation cases still return false to the platform's exact
+    // normalizer; the binary64-only all-range SIMD fallback remains guarded.
+    {
+        const __m128 a = _mm_loadu_ps(m_fmacVs);
+        __m128 b;
+        switch (static_cast<FmacSource>(source))
+        {
+        case FmacSource::Broadcast: b = _mm_set1_ps(m_fmacVt[broadcast]); break;
+        case FmacSource::Q: b = _mm_set1_ps(m_fmacQ); break;
+        case FmacSource::I: b = _mm_set1_ps(m_fmacI); break;
+        case FmacSource::Full: b = _mm_loadu_ps(m_fmacVt); break;
+        default: return false;
+        }
+        __m128i productBits, exactProductZero, resultBits, resultMagnitude;
+        if (!classifyProductSumFmacFastBits(a, b, result, dest, productBits, exactProductZero, resultBits, resultMagnitude))
+            return false;
+        const auto reversed = [](uint32_t bits)
+        {
+            return ((bits & 1u) << 3u) | ((bits & 2u) << 1u) |
+                   ((bits & 4u) >> 1u) | ((bits & 8u) >> 3u);
+        };
+        if (dest != 0u)
+        {
+            const uint32_t resultSigns = reversed(static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(resultBits)))) & dest;
+            const uint32_t resultZero = reversed(static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(
+                _mm_cmpeq_epi32(resultMagnitude, _mm_setzero_si128()))))) & dest;
+            const uint32_t productSigns = reversed(static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(productBits)))) & dest;
+            const uint32_t productZero = reversed(static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(exactProductZero)))) & dest;
+            const uint32_t status = (resultZero != 0u ? 1u : 0u) | (resultSigns != 0u ? 2u : 0u);
+            const uint32_t sticky = (productZero != 0u ? 1u : 0u) | (productSigns != 0u ? 2u : 0u);
+            queueFmacFlags(resultZero | (resultSigns << 4u), status, sticky);
+        }
+        applyDest(dst, result, dest);
+        return true;
+    }
+#endif
+    (void)dst; (void)result; (void)dest; (void)source; (void)broadcast;
+    return false;
+}
