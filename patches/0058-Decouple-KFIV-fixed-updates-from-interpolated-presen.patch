+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "runtime/kfiv_frame.h"
+#include "game_overrides.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "ps2_syscalls.h"
+#include "runtime/ee_scheduler.h"
+#include "runtime/fixed_frame_pacer.h"
+#include "runtime/gs/gs_interpolation.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <stdexcept>
+#include <unordered_map>
+namespace
+{
+struct State
+{
+    FixedFramePacer pacer;
+    PS2Runtime::RecompiledFunction timerReset = nullptr;
+};
+std::mutex stateMutex;
+std::unordered_map<PS2Runtime *, std::shared_ptr<State>> states;
+std::shared_ptr<State> state(PS2Runtime *runtime)
+{
+    std::lock_guard lock(stateMutex);
+    return states.at(runtime);
+}
+
+void completedGameFrame(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    const uint32_t returnPc = getRegU32(ctx, 31);
+    // Execute the original timer reset unchanged, including its MMIO write.
+    state(runtime)->timerReset(rdram, ctx, runtime);
+    if (returnPc != 0x001002E8u)
+    {
+        ps2_gs_interpolation::suspend(runtime->gs());
+        return;
+    }
+    const auto &regs = runtime->memory().gs();
+    auto &gs = runtime->gs();
+    GSPresentationRequest request{};
+    request.pmode = regs.pmode;
+    request.smode2 = regs.smode2;
+    request.dispfb1 = regs.dispfb1;
+    request.display1 = regs.display1;
+    request.dispfb2 = regs.dispfb2;
+    request.display2 = regs.display2;
+    request.bgcolor = regs.bgcolor;
+    request.vsyncTick = regs.vsyncTick.load(std::memory_order_acquire);
+    request.contextFrames[0] = gs.getContextFrame(0);
+    request.contextFrames[1] = gs.getContextFrame(1);
+    request.hasPreferredSource = gs.getPreferredDisplaySource(request.preferredSource, request.preferredDestFbp);
+    ps2_gs_interpolation::sealFrame(gs, request);
+}
+
+void nativeFrameBoundary(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    // Reconstruct only the caller-preserving prologue. The original buffer
+    // swaps and epilogue still execute through their generated continuation.
+    // This replaces the timer/FIELD polling limiter, not a gameplay update.
+    const uint32_t stack = getRegU32(ctx, 29) - 0x40u;
+    auto &memory = runtime->memory();
+    memory.write64(stack, GPR_U64(ctx, 16));
+    memory.write64(stack + 0x10u, GPR_U64(ctx, 17));
+    memory.write64(stack + 0x20u, GPR_U64(ctx, 18));
+    memory.write64(stack + 0x30u, GPR_U64(ctx, 31));
+    SET_GPR_U32(ctx, 29, stack);
+    SET_GPR_U32(ctx, 17, 0x00430000u);
+    SET_GPR_U32(ctx, 18, 0x00430000u);
+    SET_GPR_U32(ctx, 4, 0u);
+    ctx->pc = 0x0020B7ECu;
+    ps2_syscalls::FlushCache(rdram, ctx, runtime);
+    auto &scheduler = runtime->eeScheduler();
+    scheduler.bindMainContextForSyscall(*ctx, rdram);
+    const auto deadline = state(runtime)->pacer.next(FixedFramePacer::Clock::now());
+    scheduler.waitHostDeadline(deadline, 0x0020B7ECu);
+}
+
+void applyNativeFrameBoundary(PS2Runtime &runtime)
+{
+    const char *enabled = std::getenv("PS2X_KFIV_FIXED_FRAME");
+    if (!enabled || std::strcmp(enabled, "1") != 0)
+        return;
+    // Whole-ELF identity is checked by the override registry; validate the
+    // limiter and original continuation again before touching function lookup.
+    if (runtime.memory().read32(0x20B780u) != 0x27BDFFC0u || runtime.memory().read32(0x20B7A8u) != 0x3442B0C7u ||
+        runtime.memory().read32(0x20B7ECu) != 0x8F85A408u || !runtime.hasFunction(0x20B7ECu))
+        throw std::runtime_error("KFIV frame boundary signature mismatch");
+    auto frameState = std::make_shared<State>();
+    {
+        std::lock_guard lock(stateMutex);
+        const auto old = states.find(&runtime);
+        if (old != states.end())
+            frameState->timerReset = old->second->timerReset;
+        states[&runtime] = frameState;
+    }
+    if (!runtime.replaceFunction(0x20B780u, &nativeFrameBoundary))
+        throw std::runtime_error("KFIV frame boundary entry missing");
+    std::fprintf(stderr, "[kfiv-frame] native 30000/1001 Hz frame pacing enabled\n");
+    const char *interpolation = std::getenv("PS2X_FRAME_INTERPOLATION");
+    if (interpolation && std::strcmp(interpolation, "1") == 0)
+    {
+        if (runtime.memory().read32(0x20D078u) != 0x3C021000u || runtime.memory().read32(0x20D07Cu) != 0xAF80A414u ||
+            runtime.memory().read32(0x20D080u) != 0x03E00008u || runtime.memory().read32(0x20D084u) != 0xAC400000u)
+            throw std::runtime_error("KFIV completed frame signature mismatch");
+        const auto original = runtime.lookupFunction(0x20D078u);
+        // Reapplying metadata on one runtime must never wrap our own hook.
+        if (original != &completedGameFrame)
+            frameState->timerReset = original;
+        if (!frameState->timerReset || !runtime.replaceFunction(0x20D078u, &completedGameFrame))
+            throw std::runtime_error("KFIV completed frame function missing");
+    }
+}
+
+} // namespace
+namespace ps2_kfiv_frame
+{
+void forgetRuntime(PS2Runtime &runtime)
+{
+    std::lock_guard lock(stateMutex);
+    states.erase(&runtime);
+}
+void registerOverrides()
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        ps2_game_overrides::registerDescriptor(
+            {"KFIV native fixed frame boundary", "SLUS_203.18", 0x00100008u, 0xBDA82D37u, &applyNativeFrameBoundary});
+    });
+}
+} // namespace ps2_kfiv_frame
