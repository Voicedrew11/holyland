diff --git a/ps2xRuntime/src/lib/gs/gs_interpolation.cpp b/ps2xRuntime/src/lib/gs/gs_interpolation.cpp
new file mode 100644
index 0000000..02c15fe
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_interpolation.cpp
@@ -0,0 +1,656 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "runtime/gs/gs_interpolation.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#ifdef PS2X_HAS_VULKAN_GS
+#include "runtime/gs/gs_vulkan_backend.h"
+#endif
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cfenv>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <unordered_map>
+#include <utility>
+#include <variant>
+#if defined(_MSC_VER) && defined(_M_X64)
+#include <xmmintrin.h>
+#endif
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+int currentRounding()
+{
+#if defined(_MSC_VER) && defined(_M_X64) && !defined(__clang__)
+    switch (_mm_getcsr() & _MM_ROUND_MASK)
+    {
+    case _MM_ROUND_DOWN:
+        return FE_DOWNWARD;
+    case _MM_ROUND_UP:
+        return FE_UPWARD;
+    case _MM_ROUND_TOWARD_ZERO:
+        return FE_TOWARDZERO;
+    default:
+        return FE_TONEAREST;
+    }
+#else
+    return std::fegetround();
+#endif
+}
+struct Palette
+{
+    GSTex0Reg tex;
+    GSTexClutReg clut;
+};
+struct Image
+{
+    std::vector<uint8_t> bytes;
+};
+struct Clear
+{
+    GSContext context;
+    uint32_t rgba;
+};
+struct Write
+{
+    uint32_t psm, base, bw, x, y, value;
+};
+struct Draw
+{
+    GSPrimitiveBatch batch;
+    int rounding;
+};
+struct TextureFlush
+{
+};
+using Command = std::variant<Draw, Palette, GSTransferCommand, Image, Clear, Write, TextureFlush>;
+struct Frame
+{
+    std::vector<Command> commands;
+    std::vector<uint8_t> startVram;
+    GSPresentationRequest request{};
+    PresentationFrame canonical;
+    PresentationFrame verifiedCanonical;
+    std::vector<uint8_t> verifiedVram;
+    size_t bytes = 0;
+    Clock::time_point completed;
+    uint64_t number = 0;
+    bool valid = true;
+};
+
+// Match only perspective textured triangles with the same material and UVs.
+// HUD sprites, clipped/new geometry and ambiguous matches remain at their
+// original positions. No object or simulation state is guessed or written.
+uint64_t triangleKey(const GSPrimitiveBatch &b)
+{
+    if (b.vertexCount != 3 || !b.state.prim.tme || b.state.prim.fst)
+        return 0;
+    uint64_t key = 1469598103934665603ull;
+    auto add = [&](uint64_t value) { key = (key ^ value) * 1099511628211ull; };
+    const auto &s = b.state;
+    const auto &c = s.context;
+    const auto &t = c.tex0;
+    for (uint64_t v : {uint64_t(t.tbp0),
+                       uint64_t(t.tbw),
+                       uint64_t(t.psm),
+                       uint64_t(t.tw),
+                       uint64_t(t.th),
+                       uint64_t(t.cbp),
+                       uint64_t(t.cpsm),
+                       uint64_t(t.csa),
+                       uint64_t(t.tcc),
+                       uint64_t(t.tfx),
+                       c.tex1,
+                       c.clamp,
+                       c.alpha,
+                       c.test,
+                       c.fba,
+                       uint64_t(c.frame.psm),
+                       uint64_t(c.frame.fbw),
+                       uint64_t(c.frame.fbmsk),
+                       uint64_t(c.zbuf.psm),
+                       uint64_t(c.zbuf.zmask),
+                       uint64_t(s.prim.abe),
+                       uint64_t(s.prim.iip),
+                       uint64_t(s.prim.fge),
+                       s.scanmsk})
+        add(v);
+    for (const auto &v : b.vertices)
+    {
+        if (!std::isfinite(v.q) || v.q <= 0 || !std::isfinite(v.s) || !std::isfinite(v.t))
+            return 0;
+        const double u = double(v.s) / v.q, tcoord = double(v.t) / v.q;
+        if (std::abs(u) > 10000 || std::abs(tcoord) > 10000)
+            return 0;
+        add(uint64_t(int64_t(std::llround(u * 4096))));
+        add(uint64_t(int64_t(std::llround(tcoord * 4096))));
+    }
+    return key ? key : 1;
+}
+double distance(const GSPrimitiveBatch &a, const GSPrimitiveBatch &b)
+{
+    double total = 0;
+    for (unsigned i = 0; i < 3; ++i)
+    {
+        const auto &x = a.vertices[i];
+        const auto &y = b.vertices[i];
+        if (!std::isfinite(x.x) || !std::isfinite(x.y) || !std::isfinite(y.x) || !std::isfinite(y.y) ||
+            std::abs(x.x - y.x) > 48 || std::abs(x.y - y.y) > 48 || x.q / y.q < 0.8f || x.q / y.q > 1.25f)
+            return 1e30;
+        total += (x.x - y.x) * (x.x - y.x) + (x.y - y.y) * (x.y - y.y);
+    }
+    return total;
+}
+GSPrimitiveBatch interpolate(const GSPrimitiveBatch &previous, const GSPrimitiveBatch &current, float alpha)
+{
+    auto out = current;
+    for (unsigned i = 0; i < 3; ++i)
+    {
+        const auto &a = previous.vertices[i];
+        const auto &b = current.vertices[i];
+        auto &v = out.vertices[i];
+        v.x = std::lerp(a.x, b.x, alpha);
+        v.y = std::lerp(a.y, b.y, alpha);
+        v.z = std::lerp(a.z, b.z, double(alpha));
+        v.s = std::lerp(a.s, b.s, alpha);
+        v.t = std::lerp(a.t, b.t, alpha);
+        v.q = std::lerp(a.q, b.q, alpha);
+        auto color = [&](uint8_t x, uint8_t y) {
+            return uint8_t(std::clamp(std::lround(std::lerp(float(x), float(y), alpha)), 0l, 255l));
+        };
+        v.r = color(a.r, b.r);
+        v.g = color(a.g, b.g);
+        v.b = color(a.b, b.b);
+        v.a = color(a.a, b.a);
+        v.fog = color(a.fog, b.fog);
+    }
+    return out;
+}
+
+struct Controller
+{
+    std::unique_ptr<GSRasterBackend> actual, canonicalRenderer, shadow;
+    std::mutex captureMutex, renderMutex;
+    std::shared_ptr<Frame> current, previous;
+    std::deque<std::shared_ptr<Frame>> completed;
+    size_t queuedBytes = 0;
+    std::vector<uint8_t> canonicalVram;
+    bool canonicalInitialized = false, stopped = false, verify = false, stats = false;
+    std::vector<std::shared_ptr<Frame>> framePool;
+    std::vector<Command> pending;
+    bool valid = false;
+    size_t pendingBytes = 0;
+    uint64_t sequence = 0, checked = 0, exact = 0, mismatches = 0, rendered = 0;
+    std::vector<const GSPrimitiveBatch *> matches;
+    std::shared_ptr<Frame> matchingPrevious;
+    PresentationFrame lastEndpoint;
+    std::vector<uint8_t> replayVram;
+    bool endpointExact = false;
+    Clock::time_point lastBoundary{};
+    explicit Controller(std::unique_ptr<GSRasterBackend> inner) : actual(std::move(inner))
+    {
+        auto makeRenderer = [&]() -> std::unique_ptr<GSRasterBackend> {
+#ifdef PS2X_HAS_VULKAN_GS
+            if (dynamic_cast<GSVulkanBackend *>(actual.get()))
+                return std::make_unique<GSVulkanBackend>();
+#endif
+            return std::make_unique<GSCpuBackend>();
+        };
+        canonicalRenderer = makeRenderer();
+        shadow = makeRenderer();
+        const char *setting = std::getenv("PS2X_INTERPOLATION_VERIFY");
+        verify = setting && std::strcmp(setting, "1") == 0;
+        const char *statistics = std::getenv("PS2X_STATS");
+        stats = statistics && *statistics && *statistics != '0';
+    }
+    void stopCapture()
+    {
+        stopped = true;
+        pending.clear();
+        completed.clear();
+        queuedBytes = 0;
+        std::fprintf(stderr, "[gs:interpolation] capture limit reached; using "
+                             "original presentation\n");
+    }
+    template <class T, class... Args> void record(Args &&...args)
+    {
+        if (stopped || !valid)
+            return;
+        pendingBytes += sizeof(Command);
+        if (pendingBytes > 64u * 1024u * 1024u)
+        {
+            stopCapture();
+            return;
+        }
+        pending.emplace_back(std::in_place_type<T>, std::forward<Args>(args)...);
+    }
+    void seal(const GSPresentationRequest &request)
+    {
+        std::lock_guard lock(captureMutex);
+        if (stopped)
+            return;
+        lastBoundary = Clock::now();
+        if (!valid)
+        {
+            // The first game boundary is the checkpoint. Startup movies can run
+            // for minutes without filling a capture buffer before gameplay starts.
+            actual->SnapshotVram(canonicalVram);
+            valid = canonicalVram.size() == (4u << 20);
+            return;
+        }
+        if (completed.size() >= 6 || queuedBytes + pendingBytes > 128u * 1024u * 1024u)
+        {
+            stopCapture();
+            return;
+        }
+        std::shared_ptr<Frame> frame;
+        for (const auto &candidate : framePool)
+            if (candidate.use_count() == 1)
+            {
+                frame = candidate;
+                break;
+            }
+        if (!frame)
+        {
+            frame = std::make_shared<Frame>();
+            framePool.push_back(frame);
+        }
+        frame->commands.swap(pending);
+        frame->request = request;
+        frame->bytes = pendingBytes;
+        frame->verifiedCanonical = {};
+        frame->verifiedVram.clear();
+        frame->canonical = {};
+        frame->valid = true;
+        // Optional validation pays for a synchronous readback. Ordinary play
+        // only hands off owned commands, never waits for extra GPU frames.
+        if (verify)
+        {
+            actual->Flush();
+            actual->Sync(GSSyncReason::Presentation);
+            frame->verifiedCanonical = actual->Present(request);
+            actual->SnapshotVram(frame->verifiedVram);
+        }
+        frame->completed = Clock::now();
+        frame->number = ++sequence;
+        completed.push_back(frame);
+        queuedBytes += frame->bytes;
+        pending.clear();
+        pending.reserve(frame->commands.size());
+        pendingBytes = 0;
+    }
+    void match(const Frame &frame, const Frame *prior)
+    {
+        matches.assign(frame.commands.size(), nullptr);
+        if (!prior || !prior->valid)
+            return;
+        std::unordered_map<uint64_t, std::vector<const GSPrimitiveBatch *>> candidates;
+        for (const auto &command : prior->commands)
+            if (const auto *d = std::get_if<Draw>(&command))
+                if (const auto key = triangleKey(d->batch))
+                    candidates[key].push_back(&d->batch);
+        for (size_t i = 0; i < frame.commands.size(); ++i)
+            if (const auto *draw = std::get_if<Draw>(&frame.commands[i]))
+            {
+                auto found = candidates.find(triangleKey(draw->batch));
+                if (found == candidates.end())
+                    continue;
+                const GSPrimitiveBatch *best = nullptr;
+                double first = 1e30, second = 1e30;
+                for (const auto *candidate : found->second)
+                    if (candidate)
+                    {
+                        const double delta = distance(*candidate, draw->batch);
+                        if (delta < first)
+                        {
+                            second = first;
+                            first = delta;
+                            best = candidate;
+                        }
+                        else
+                            second = std::min(second, delta);
+                    }
+                // Reject duplicate or similarly plausible correspondences.
+                if (best && (second > first * 4 + 1))
+                {
+                    matches[i] = best;
+                    for (auto &candidate : found->second)
+                        if (candidate == best)
+                        {
+                            candidate = nullptr;
+                            break;
+                        }
+                }
+            }
+    }
+    void submitCommands(GSRasterBackend &renderer, const Frame &frame, float alpha)
+    {
+        const int callerRounding = std::fegetround();
+        int activeRounding = callerRounding;
+        struct Restore
+        {
+            int mode;
+            ~Restore()
+            {
+                if (mode != -1)
+                    std::fesetround(mode);
+            }
+        } restore{callerRounding};
+        for (size_t i = 0; i < frame.commands.size(); ++i)
+        {
+            std::visit(
+                [&](const auto &value) {
+                    using T = std::decay_t<decltype(value)>;
+                    if constexpr (std::is_same_v<T, Draw>)
+                    {
+                        if (activeRounding != value.rounding)
+                        {
+                            std::fesetround(value.rounding);
+                            activeRounding = value.rounding;
+                        }
+                        renderer.Submit(alpha < 1 && i < matches.size() && matches[i]
+                                            ? interpolate(*matches[i], value.batch, alpha)
+                                            : value.batch);
+                    }
+                    else if constexpr (std::is_same_v<T, Palette>)
+                        renderer.LoadClut(value.tex, value.clut);
+                    else if constexpr (std::is_same_v<T, GSTransferCommand>)
+                        renderer.BeginTransfer(value);
+                    else if constexpr (std::is_same_v<T, Image>)
+                        renderer.UploadImage(value.bytes.data(), uint32_t(value.bytes.size()));
+                    else if constexpr (std::is_same_v<T, Clear>)
+                        renderer.ClearFramebuffer(value.context, value.rgba);
+                    else if constexpr (std::is_same_v<T, Write>)
+                        renderer.WriteVram(value.psm, value.base, value.bw, value.x, value.y, value.value);
+                    else if constexpr (std::is_same_v<T, TextureFlush>)
+                        renderer.TextureFlush();
+                },
+                frame.commands[i]);
+        }
+        renderer.Flush();
+    }
+    PresentationFrame replay(const Frame &frame, float alpha)
+    {
+        // CPU Initialize borrows its pointer. Keep immutable captured bytes
+        // separate from both renderers' writable video memory.
+        replayVram = frame.startVram;
+        shadow->Initialize(replayVram.data(), uint32_t(replayVram.size()));
+        submitCommands(*shadow, frame, alpha);
+        return shadow->Present(frame.request);
+    }
+    PresentationFrame present(float phase)
+    {
+        std::lock_guard renderLock(renderMutex);
+        {
+            std::lock_guard lock(captureMutex);
+            if (stopped || !valid)
+                return {};
+            // Menus, movies and loading can enter another original loop that
+            // never calls the gameplay boundary. Show that live backend, not
+            // an indefinitely stale game frame; resume from a fresh checkpoint.
+            if (phase < 0 && Clock::now() - lastBoundary > std::chrono::milliseconds(100))
+            {
+                resetCapture();
+                return {};
+            }
+        }
+        try
+        {
+            if (!canonicalInitialized)
+            {
+                canonicalRenderer->Initialize(canonicalVram.data(), uint32_t(canonicalVram.size()));
+                canonicalInitialized = true;
+            }
+            // Drain a bounded queue. Every original draw/transfer is executed
+            // in order, even if the display cannot show every completed frame.
+            for (unsigned n = 0; n < 6; ++n)
+            {
+                std::shared_ptr<Frame> next;
+                {
+                    std::lock_guard lock(captureMutex);
+                    if (completed.empty())
+                        break;
+                    next = std::move(completed.front());
+                    completed.pop_front();
+                    queuedBytes -= next->bytes;
+                }
+                canonicalRenderer->SnapshotVram(next->startVram);
+                submitCommands(*canonicalRenderer, *next, 1);
+                next->canonical = canonicalRenderer->Present(next->request);
+                if (verify)
+                {
+                    std::vector<uint8_t> after;
+                    canonicalRenderer->SnapshotVram(after);
+                    if (next->canonical.width != next->verifiedCanonical.width ||
+                        next->canonical.height != next->verifiedCanonical.height ||
+                        next->canonical.pixels != next->verifiedCanonical.pixels || after != next->verifiedVram)
+                    {
+                        std::fprintf(stderr,
+                                     "[gs:interpolation] original renderer verification "
+                                     "failed at frame %llu\n",
+                                     static_cast<unsigned long long>(next->number));
+                        std::lock_guard lock(captureMutex);
+                        stopCapture();
+                        return {};
+                    }
+                }
+                previous = std::move(current);
+                current = std::move(next);
+            }
+            if (!current)
+                return {};
+            const auto &frame = *current;
+            if (checked != frame.number)
+            {
+                matchingPrevious = previous;
+                match(frame, previous.get());
+                lastEndpoint = replay(frame, 1);
+                endpointExact = lastEndpoint.width == frame.canonical.width &&
+                                lastEndpoint.height == frame.canonical.height &&
+                                lastEndpoint.pixels == frame.canonical.pixels;
+                checked = frame.number;
+                if (endpointExact)
+                    ++exact;
+                else
+                    ++mismatches;
+                if (stats && checked % 120 == 0)
+                    std::fprintf(
+                        stderr,
+                        "[gs:interpolation] frames=%llu exact=%llu fallback=%llu "
+                        "matched=%zu/%zu rendered=%llu verify=%d\n",
+                        static_cast<unsigned long long>(checked), static_cast<unsigned long long>(exact),
+                        static_cast<unsigned long long>(mismatches),
+                        size_t(std::count_if(matches.begin(), matches.end(), [](auto *p) { return p != nullptr; })),
+                        matches.size(), static_cast<unsigned long long>(rendered), int(verify));
+            }
+            if (!endpointExact)
+                return frame.canonical;
+            const float alpha = std::isfinite(phase) && phase >= 0.0f
+                                    ? std::clamp(phase, 0.0f, 1.0f)
+                                    : std::clamp(std::chrono::duration<float>(Clock::now() - frame.completed).count() *
+                                                     (30000.0f / 1001.0f),
+                                                 0.0f, 1.0f);
+            if (alpha >= 1)
+                return frame.canonical;
+            ++rendered;
+            return replay(frame, alpha);
+        }
+        catch (const std::exception &error)
+        {
+            std::fprintf(stderr, "[gs:interpolation] using original presentation: %s\n", error.what());
+            std::lock_guard lock(captureMutex);
+            stopCapture();
+            return {};
+        }
+    }
+    void resetCapture()
+    {
+        pending.clear();
+        completed.clear();
+        current.reset();
+        previous.reset();
+        matchingPrevious.reset();
+        matches.clear();
+        framePool.clear();
+        canonicalVram.clear();
+        valid = false;
+        pendingBytes = queuedBytes = 0;
+        canonicalInitialized = false;
+        stopped = false;
+    }
+};
+std::mutex registryMutex;
+std::unordered_map<GS *, std::weak_ptr<Controller>> registry;
+std::shared_ptr<Controller> get(GS &owner)
+{
+    std::lock_guard lock(registryMutex);
+    auto it = registry.find(&owner);
+    return it == registry.end() ? nullptr : it->second.lock();
+}
+class Backend final : public GSRasterBackend
+{
+    std::shared_ptr<Controller> c;
+    GS *owner;
+
+  public:
+    Backend(std::shared_ptr<Controller> controller, GS *o) : c(std::move(controller)), owner(o)
+    {
+        std::lock_guard lock(registryMutex);
+        registry[owner] = c;
+    }
+    ~Backend() override
+    {
+        std::lock_guard lock(registryMutex);
+        auto it = registry.find(owner);
+        if (it != registry.end() && it->second.lock() == c)
+            registry.erase(it);
+    }
+    void Initialize(uint8_t *v, uint32_t n) override
+    {
+        std::scoped_lock lock(c->renderMutex, c->captureMutex);
+        c->actual->Initialize(v, n);
+        c->resetCapture();
+    }
+    void Reset() override
+    {
+        std::scoped_lock lock(c->renderMutex, c->captureMutex);
+        c->actual->Reset();
+        c->resetCapture();
+    }
+    void Submit(const GSPrimitiveBatch &b) override
+    {
+        std::lock_guard lock(c->captureMutex);
+        c->record<Draw>(b, currentRounding());
+        c->actual->Submit(b);
+    }
+    void LoadClut(const GSTex0Reg &t, const GSTexClutReg &cl) override
+    {
+        std::lock_guard lock(c->captureMutex);
+        c->record<Palette>(t, cl);
+        c->actual->LoadClut(t, cl);
+    }
+    void BeginTransfer(const GSTransferCommand &t) override
+    {
+        std::lock_guard lock(c->captureMutex);
+        c->record<GSTransferCommand>(t);
+        c->actual->BeginTransfer(t);
+    }
+    void UploadImage(const uint8_t *data, uint32_t n) override
+    {
+        std::lock_guard lock(c->captureMutex);
+        if (c->valid && !c->stopped && data && n)
+        {
+            c->pendingBytes += n;
+            if (c->pendingBytes > 64u * 1024u * 1024u)
+                c->stopCapture();
+            else
+                c->record<Image>(std::vector<uint8_t>(data, data + n));
+        }
+        c->actual->UploadImage(data, n);
+    }
+    void Flush() override
+    {
+        c->actual->Flush();
+    }
+    void TextureFlush() override
+    {
+        std::lock_guard lock(c->captureMutex);
+        c->record<::TextureFlush>();
+        c->actual->TextureFlush();
+    }
+    void Sync(GSSyncReason r) override
+    {
+        c->actual->Sync(r);
+    }
+    PresentationFrame Present(const GSPresentationRequest &r) override
+    {
+        return c->actual->Present(r);
+    }
+    bool ClearFramebuffer(const GSContext &ctx, uint32_t rgba) override
+    {
+        std::lock_guard lock(c->captureMutex);
+        c->record<Clear>(ctx, rgba);
+        return c->actual->ClearFramebuffer(ctx, rgba);
+    }
+    uint32_t ConsumeLocalToHostBytes(uint8_t *p, uint32_t n) override
+    {
+        return c->actual->ConsumeLocalToHostBytes(p, n);
+    }
+    uint32_t ReadVram(uint32_t p, uint32_t b, uint32_t w, uint32_t x, uint32_t y) const override
+    {
+        return c->actual->ReadVram(p, b, w, x, y);
+    }
+    void WriteVram(uint32_t p, uint32_t b, uint32_t w, uint32_t x, uint32_t y, uint32_t v) override
+    {
+        std::lock_guard lock(c->captureMutex);
+        c->record<Write>(p, b, w, x, y, v);
+        c->actual->WriteVram(p, b, w, x, y, v);
+    }
+    void SnapshotVram(std::vector<uint8_t> &out) const override
+    {
+        c->actual->SnapshotVram(out);
+    }
+    GSTransferSnapshot GetTransferSnapshot() const override
+    {
+        return c->actual->GetTransferSnapshot();
+    }
+};
+} // namespace
+namespace ps2_gs_interpolation
+{
+std::unique_ptr<GSRasterBackend> wrap(std::unique_ptr<GSRasterBackend> backend, GS *owner)
+{
+    const char *setting = std::getenv("PS2X_FRAME_INTERPOLATION");
+    if (!owner || !setting || std::strcmp(setting, "1") != 0)
+        return backend;
+    auto controller = std::make_shared<Controller>(std::move(backend));
+    std::fprintf(stderr, "[gs:interpolation] independent presentation renderer enabled\n");
+    return std::make_unique<Backend>(std::move(controller), owner);
+}
+void sealFrame(GS &owner, const GSPresentationRequest &request)
+{
+    if (auto c = get(owner))
+        c->seal(request);
+}
+void suspend(GS &owner)
+{
+    if (auto c = get(owner))
+    {
+        std::scoped_lock lock(c->renderMutex, c->captureMutex);
+        if (c->valid)
+            c->resetCapture();
+    }
+}
+PresentationFrame present(GS &owner, float phase)
+{
+    if (auto c = get(owner))
+        return c->present(phase);
+    return {};
+}
+} // namespace ps2_gs_interpolation
