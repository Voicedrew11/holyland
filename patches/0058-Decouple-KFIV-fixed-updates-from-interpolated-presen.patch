index 0000000..973e89b
--- /dev/null
+++ b/ps2xRuntime/include/runtime/fixed_frame_pacer.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <chrono>
+#include <cstdint>
+
+// A host deadline for each original game update. Presentation never calls this.
+// Keep the NTSC 30000/1001 cadence without a floating point clock or drift.
+class FixedFramePacer
+{
+public:
+    using Clock = std::chrono::steady_clock;
+    using TimePoint = Clock::time_point;
+    TimePoint next(TimePoint now)
+    {
+        constexpr auto period = std::chrono::nanoseconds(33366666);
+        if (!m_started)
+        {
+            m_deadline = now;
+            m_remainder = 0;
+            m_started = true;
+        }
+        else
+        {
+            m_deadline += period;
+            m_remainder += 20000;
+            if (m_remainder >= 30000)
+            {
+                m_deadline += std::chrono::nanoseconds(1);
+                m_remainder -= 30000;
+            }
+            // Keep ordinary late work on the same timeline. Rebasing on
+            // every small overrun permanently loses time even when the next
+            // update has ample spare time. A long stall discards backlog.
+            if (now > m_deadline + period * 4)
+            {
+                m_deadline = now;
+                m_remainder = 0;
+            }
+        }
+        return m_deadline;
+    }
+private:
+    TimePoint m_deadline{};
+    uint32_t m_remainder = 0;
+    bool m_started = false;
+};
