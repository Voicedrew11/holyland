@@ -0,0 +1,351 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Generate a private native VU1 catalog from an explicitly owned ELF.
+
+The emitted code specializes canonical compact-descriptor runtime semantics in
+bounded 16-pair groups. The runtime retains the interpreter for other programs,
+code changes, unsupported units and execution boundaries. Owned ELF bytes and
+generated catalogs belong in private build directories, outside source trees.
+
+Python 3.8 or later is required. This tool does not invoke a system compiler or
+modify canonical runtime sources.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import os
+import tempfile
+import struct
+from vu_native_input import read_elf
+
+
+def function(text, signature):
+    if text.count(signature) != 1:
+        raise ValueError(f'Expected one canonical function anchor: {signature!r}')
+    begin = text.index(signature)
+    end = text.index('\n}\n', begin) + 3
+    return text[begin:end]
+
+
+def prefix(text, signature):
+    if text.count(signature) != 1:
+        raise ValueError(f'Expected one canonical prefix anchor: {signature!r}')
+    return text[:text.index(signature)]
+
+
+def replace_once(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError(f'Expected one occurrence of {old[:100]!r}')
+    return text.replace(old, new, 1)
+
+
+DECLARATIONS = '''
+    template<uint32_t instr> void execUpperSpecialized();
+    template<uint32_t instr, uint32_t upperInstr>
+    void execLowerSpecialized(uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory);
+    static constexpr void addVfReadSpecialized(InstructionUsage &, uint8_t, uint8_t);
+    static constexpr void addVfWriteSpecialized(InstructionUsage &, uint8_t, uint8_t);
+    static constexpr uint8_t vfReadLanesSpecialized(const InstructionUsage &, uint8_t);
+    static constexpr InstructionUsage decodeUpperUsageSpecialized(uint32_t);
+    static constexpr InstructionUsage decodeLowerUsageSpecialized(uint32_t);
+    static constexpr DecodedInstructionPair decodePairSpecialized(uint32_t lower, uint32_t upper);
+    template<uint32_t lower, uint32_t upper>
+    int issueSpecializedPair(uint8_t *vuData, uint32_t dataSize, GS &gs,
+                             PS2Memory *memory, uint32_t codeSize, uint64_t budgetEnd);
+    template<uint32_t base>
+    int trySpecializedGroup(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData,
+                            uint32_t dataSize, GS &gs, PS2Memory *memory,
+                            uint64_t budgetEnd, uint64_t generation);
+    int trySpecializedBlock(const DecodedInstructionPair &decoded, uint8_t *vuCode,
+                            uint32_t codeSize, uint8_t *vuData, uint32_t dataSize,
+                            GS &gs, PS2Memory *memory, uint64_t budgetEnd, uint64_t generation);
+    bool matchesNativeCatalogCache() const;
+'''
+
+
+def generate_catalog(runtime, code):
+    if len(code) != 16384:
+        raise ValueError('Catalog requires an exact 16 KiB VU1 image')
+    pairs = list(struct.iter_unpack('<II', code))
+    paths = ('src/lib/vu/ps2_vu1_core.cpp', 'src/lib/vu/ps2_vu1_upper.cpp',
+             'src/lib/vu/ps2_vu1_lower.cpp', 'include/runtime/ps2_vu1.h',
+             'src/lib/vu/ps2_vu1_detail.h')
+    raw = {relative: (runtime / relative).read_bytes() for relative in paths}
+    core, upper, lower, header, detail = (raw[path].decode('utf-8').replace('\r\n', '\n') for path in paths)
+    if 'DecodedIBit' not in header or 'statusAndMask' not in header or 'DecodedInstructionPair' not in header:
+        raise ValueError('Expected compact descriptor / STATUS-transform canonical runtime')
+    specialize_fmac = False
+    generation_only = True
+    parts = [prefix(upper, 'void VU1Interpreter::execUpper('),
+             prefix(lower, 'void VU1Interpreter::execLower(')]
+    # Prefixes retain the exact D lane arithmetic/normalization and EFU helpers.
+    parts.append('#include <utility>\n#include <stdexcept>\n#include <cstdio>\n')
+    parts.append('namespace { constexpr uint8_t laneForComponentSpecialized(uint32_t c) { return static_cast<uint8_t>(8u >> c); } }\n')
+    image_pairs = ','.join(f'{{0x{lo:08x}u,0x{hi:08x}u}}' for lo, hi in pairs)
+    parts.append('namespace { constexpr uint32_t nativeCatalogPairs[][2] = {' + image_pairs + '}; }\n')
+    parts.append('''\x20
+bool VU1Interpreter::matchesNativeCatalogCache() const
+{
+    if (!m_decodedCodeCacheValid || m_unit != Unit::VU1 || m_cachedMemory == nullptr ||
+        m_cachedCodeSize != sizeof(nativeCatalogPairs) || m_cachedVuCode != m_cachedMemory->getVU1Code())
+        return false;
+    for (uint32_t index = 0; index < kMaxDecodedPairs; ++index)
+        if (m_decodedCodeCache[index].lower != nativeCatalogPairs[index][0] ||
+            m_decodedCodeCache[index].upper != nativeCatalogPairs[index][1])
+            return false;
+    return true;
+}
+''')
+    upper_function = function(upper, 'void VU1Interpreter::execUpper(')
+    upper_function = replace_once(upper_function, 'void VU1Interpreter::execUpper(uint32_t instr)',
+        'template<uint32_t instr>\nvoid VU1Interpreter::execUpperSpecialized()')
+    if specialize_fmac:
+        normalize = function(core, 'void VU1Interpreter::normalizeFmacResult(')
+        normalize = replace_once(normalize, 'void VU1Interpreter::normalizeFmacResult(',
+            'template<uint32_t instr>\nvoid VU1Interpreter::normalizeFmacResultSpecialized(')
+        normalize = replace_once(normalize, '    const FmacDecode fmac = decodeFmac(m_currentUpperInstruction);',
+            '    constexpr uint32_t opcode = instr & 0x3fu;\n'
+            '    constexpr uint32_t index = opcode >= 0x3cu ? 64u + ((instr & 3u) | ((instr >> 4u) & 0x7cu)) : opcode;\n'
+            '    constexpr FmacDecode fmac = kFmacDecode[index];')
+        normalize = normalize.replace('    const bool single =', '    constexpr bool single =', 1)
+        normalize = replace_once(normalize, '    const bool productSum = isProductSum(fmac.op);',
+            '    constexpr bool productSum = fmac.op == FmacOp::MAdd || fmac.op == FmacOp::MSub || fmac.op == FmacOp::OuterMSub;')
+        parts.append(normalize)
+        for helper in ('applyFmacDest', 'applyFmacDestAcc'):
+            apply = function(core, 'void VU1Interpreter::' + helper + '(')
+            apply = replace_once(apply, 'void VU1Interpreter::' + helper + '(',
+                'template<uint32_t instr>\nvoid VU1Interpreter::' + helper + 'Specialized(')
+            apply = apply.replace('normalizeFmacResult(', 'normalizeFmacResultSpecialized<instr>(')
+            parts.append(apply)
+            upper_function = upper_function.replace(helper + '(', helper + 'Specialized<instr>(')
+    lower_function = function(lower, 'void VU1Interpreter::execLower(')
+    lower_function = replace_once(lower_function,
+        'void VU1Interpreter::execLower(uint32_t instr, uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory, uint32_t upperInstr)',
+        'template<uint32_t instr, uint32_t upperInstr>\nvoid VU1Interpreter::execLowerSpecialized(uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory)')
+    parts.extend((upper_function, lower_function))
+    for name in ('addVfRead', 'addVfWrite', 'vfReadLanes', 'decodeUpperUsage', 'decodeLowerUsage'):
+        definition = function(core, ('uint8_t ' if name == 'vfReadLanes' else
+            'VU1Interpreter::InstructionUsage ' if name.startswith('decode') else 'void ') +
+            'VU1Interpreter::' + name + '(')
+        definition = re.sub(r'\b' + name + r'\b', name + 'Specialized', definition)
+        definition = 'constexpr ' + definition
+        definition = definition.replace(') const\n', ')\n')
+        definition = definition.replace('m_unit', 'Unit::VU1')
+        for helper in ('addVfRead', 'addVfWrite', 'vfReadLanes'):
+            definition = re.sub(r'\b' + helper + r'\b', helper + 'Specialized', definition)
+        definition = definition.replace('laneForComponent(', 'laneForComponentSpecialized(')
+        parts.append(definition)
+    decode = function(core, 'VU1Interpreter::DecodedInstructionPair VU1Interpreter::decodeInstructionPair(')
+    decode = replace_once(decode,
+        'VU1Interpreter::DecodedInstructionPair VU1Interpreter::decodeInstructionPair(const uint8_t *vuCode, uint32_t pc) const',
+        'constexpr VU1Interpreter::DecodedInstructionPair VU1Interpreter::decodePairSpecialized(uint32_t lower, uint32_t upper)')
+    decode = replace_once(decode, '    std::memcpy(&decoded.lower, vuCode + pc, sizeof(decoded.lower));', '    decoded.lower = lower;')
+    decode = replace_once(decode, '    std::memcpy(&decoded.upper, vuCode + pc + sizeof(decoded.lower), sizeof(decoded.upper));', '    decoded.upper = upper;')
+    for helper in ('decodeUpperUsage', 'decodeLowerUsage', 'vfReadLanes'):
+        decode = re.sub(r'\b' + helper + r'\b', helper + 'Specialized', decode)
+    decode = decode.replace('laneForComponent(', 'laneForComponentSpecialized(')
+    # Avoid an MSVC 19.44 LTCG ICE involving the constexpr initializer-list
+    # of pointers to subobjects. This is the same upper-then-lower traversal.
+    decode = replace_once(decode,
+        '    for (const InstructionUsage *usage : {&upperUsage, &lowerUsage})\n    {',
+        '    for (uint32_t usageIndex = 0; usageIndex < 2u; ++usageIndex)\n    {\n'
+        '        const InstructionUsage *usage = usageIndex == 0u ? &upperUsage : &lowerUsage;')
+    parts.append(decode)
+    parts.append('''
+#ifdef VU_SPECIALIZATION_VERIFY_COUNTER
+namespace {
+uint64_t privateSpecializedIssued = 0;
+struct SpecializationReport { ~SpecializationReport() {
+    std::printf("PRIVATE-SPECIALIZATION issued=%llu\\n", static_cast<unsigned long long>(privateSpecializedIssued));
+} } privateSpecializationReport;
+}
+uint64_t vuNativeIssuedForTests() { return privateSpecializedIssued; }
+#endif
+''')
+    run_function = function(core, 'void VU1Interpreter::run(')
+    begin = run_function.index('        uint64_t readyCycle = calculatePairReadyCycle(decoded);')
+    end = run_function.index('        advanceOneCycle();', begin) + len('        advanceOneCycle();')
+    issue = run_function[begin:end]
+    issue = replace_once(issue, '        uint64_t readyCycle = calculatePairReadyCycle(decoded);', '''
+        uint64_t readyCycle = m_cycle;
+        [&]<size_t... Index>(std::index_sequence<Index...>) {
+            ((readyCycle = std::max(readyCycle, m_ready[decoded.readSlots[Index]])), ...);
+        }(std::make_index_sequence<decoded.readSlotCount>{});
+        if constexpr (decoded.lowerPipeline == PipelineFdiv)
+            if (m_fdiv.valid) readyCycle = std::max(readyCycle, m_fdiv.readyCycle);
+        if constexpr (decoded.lowerPipeline == PipelineEfu)
+            readyCycle = std::max(readyCycle, m_efuResourceReady);
+        if constexpr (decoded.has(DecodedWaitQ))
+            if (m_fdiv.valid) readyCycle = std::max(readyCycle, m_fdiv.readyCycle);
+        if constexpr (decoded.has(DecodedWaitP))
+            for (const ScalarPipelineEntry &entry : m_efu)
+                if (entry.valid) readyCycle = std::max(readyCycle, entry.readyCycle);
+        if constexpr (decoded.lowerPipeline == PipelineXgkick)
+            if (m_xgkick.active) readyCycle = std::max(readyCycle, m_cycle + 1u);
+''')
+    issue = replace_once(issue, '        if (m_cycle >= budgetEnd)\n            break;', '        if (m_cycle >= budgetEnd)\n            return 3;')
+    issue = issue.replace('execUpper(decoded.upper);', 'execUpperSpecialized<upper>();')
+    issue = issue.replace('execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);',
+                          'execLowerSpecialized<lower, upper>(vuData, dataSize, gs, memory);')
+    issue = issue.replace('if (decoded.has(DecodedIBit))', 'if constexpr (decoded.has(DecodedIBit))')
+    issue = issue.replace('else if (decoded.upperVfShadowReg != 0u)', 'else if constexpr (decoded.upperVfShadowReg != 0u)')
+    issue = replace_once(issue, '        markPairWrites(decoded);', '''
+        [&]<size_t... Index>(std::index_sequence<Index...>) {
+            ((m_ready[decoded.writeSlots[Index]] = m_cycle + decoded.writeLatencies[Index]), ...);
+        }(std::make_index_sequence<decoded.writeSlotCount>{});
+        if constexpr (decoded.writeSlotCount != 0u)
+            m_writebackHorizon = std::max(m_writebackHorizon, m_cycle + decoded.maxWriteLatency);
+''')
+    parts.append('''
+template<uint32_t lower, uint32_t upper>
+int VU1Interpreter::issueSpecializedPair(uint8_t *vuData, uint32_t dataSize, GS &gs,
+                                        PS2Memory *memory, uint32_t codeSize, uint64_t budgetEnd)
+{
+    constexpr DecodedInstructionPair decoded = decodePairSpecialized(lower, upper);
+    bool programEnded = false;
+''' + issue + '''
+#ifdef VU_SPECIALIZATION_VERIFY_COUNTER
+    ++privateSpecializedIssued;
+#endif
+    return programEnded ? 2 : 1;
+}
+''')
+
+    # PRIVATE bounded compiler-layout experiment. Only whole-image admitted
+    # programs use direct generation checks. Every original per-pair commit,
+    # issue, callback and budget boundary is preserved.
+    if not generation_only:
+        raise ValueError('Bounded layout requires whole-image generation-only admission')
