+# SPDX-License-Identifier: GPL-3.0-or-later
+# Optional, private build-time VU1 catalog. No program bytes enter the source tree.
+set(PS2X_VU1_NATIVE_ELF "" CACHE FILEPATH "Owned ELF containing the VU1 MPG uploads")
+set(PS2X_VU1_NATIVE_METADATA "" CACHE FILEPATH "Pinned ordered VU1 upload metadata")
+
+if(NOT PS2X_VU1_NATIVE_ELF AND NOT PS2X_VU1_NATIVE_METADATA)
+    return()
+endif()
+if(NOT PS2X_VU1_NATIVE_ELF OR NOT PS2X_VU1_NATIVE_METADATA)
+    message(FATAL_ERROR "Native VU1 compilation requires both PS2X_VU1_NATIVE_ELF and PS2X_VU1_NATIVE_METADATA")
+endif()
+foreach(input IN ITEMS PS2X_VU1_NATIVE_ELF PS2X_VU1_NATIVE_METADATA)
+    get_filename_component(${input} "${${input}}" ABSOLUTE)
+    if(NOT EXISTS "${${input}}" OR IS_DIRECTORY "${${input}}")
+        message(FATAL_ERROR "Native VU1 input is not a file: ${input}=${${input}}")
+    endif()
+endforeach()
+
+find_package(Python3 3.8 REQUIRED COMPONENTS Interpreter)
+set(_ps2x_vu_catalog_dir "${CMAKE_CURRENT_BINARY_DIR}/vu-native")
+set(_ps2x_vu_catalog "${_ps2x_vu_catalog_dir}/vu1_catalog.inc")
+set(_ps2x_vu_manifest "${_ps2x_vu_catalog_dir}/vu1_catalog.json")
+set(_ps2x_vu_generator "${CMAKE_CURRENT_SOURCE_DIR}/tools/generate_vu_native.py")
+set(_ps2x_vu_parser "${CMAKE_CURRENT_SOURCE_DIR}/tools/vu_native_input.py")
+set(_ps2x_vu_core "${CMAKE_CURRENT_SOURCE_DIR}/src/lib/vu/ps2_vu1_core.cpp")
+
+add_custom_command(
+    OUTPUT "${_ps2x_vu_catalog}"
+    BYPRODUCTS "${_ps2x_vu_manifest}"
+    COMMAND "${CMAKE_COMMAND}" -E make_directory "${_ps2x_vu_catalog_dir}"
+    COMMAND "${Python3_EXECUTABLE}" "${_ps2x_vu_generator}"
+        --runtime "${CMAKE_CURRENT_SOURCE_DIR}"
+        --elf "${PS2X_VU1_NATIVE_ELF}"
+        --metadata "${PS2X_VU1_NATIVE_METADATA}"
+        --output "${_ps2x_vu_catalog}"
+        --manifest "${_ps2x_vu_manifest}"
+    DEPENDS
+        "${_ps2x_vu_generator}" "${_ps2x_vu_parser}"
+        "${PS2X_VU1_NATIVE_ELF}" "${PS2X_VU1_NATIVE_METADATA}"
+        "${CMAKE_CURRENT_SOURCE_DIR}/include/runtime/ps2_vu1.h"
+        "${_ps2x_vu_core}"
+        "${CMAKE_CURRENT_SOURCE_DIR}/src/lib/vu/ps2_vu1_upper.cpp"
+        "${CMAKE_CURRENT_SOURCE_DIR}/src/lib/vu/ps2_vu1_lower.cpp"
+        "${CMAKE_CURRENT_SOURCE_DIR}/src/lib/vu/ps2_vu1_detail.h"
+    COMMENT "Compiling the owned VU1 program to private native C++"
+    VERBATIM
+)
+add_custom_target(ps2_vu1_native_catalog DEPENDS "${_ps2x_vu_catalog}")
+add_dependencies(ps2_runtime ps2_vu1_native_catalog)
+set_source_files_properties("${_ps2x_vu_catalog}" PROPERTIES
+    GENERATED TRUE HEADER_FILE_ONLY TRUE)
+target_sources(ps2_runtime PRIVATE "${_ps2x_vu_catalog}")
+
+# Compile only inside the VU core so its strict floating-point flags apply.
+# The shared class definition remains identical in every translation unit.
+set_property(SOURCE "${_ps2x_vu_core}" APPEND PROPERTY COMPILE_DEFINITIONS
+    "PS2X_VU1_NATIVE_CATALOG=\"${_ps2x_vu_catalog}\"")
+set_property(SOURCE "${_ps2x_vu_core}" APPEND PROPERTY OBJECT_DEPENDS
+    "${_ps2x_vu_catalog}")
+set_source_files_properties("${_ps2x_vu_core}" PROPERTIES
+    SKIP_UNITY_BUILD_INCLUSION TRUE)
+message(STATUS "Native VU1 catalog: ${_ps2x_vu_catalog}")
