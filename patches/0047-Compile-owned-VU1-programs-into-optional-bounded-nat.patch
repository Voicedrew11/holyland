+int VU1Interpreter::trySpecializedBlock(const DecodedInstructionPair &initialDecoded,
+    uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize,
+    GS &gs, PS2Memory *memory, uint64_t budgetEnd, uint64_t generation)
