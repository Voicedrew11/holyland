+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Validate explicit owned VU1 input images without writing any outputs (Python 3.8+)."""
+import hashlib
+import json
+import struct
+import re
+
+CODE_SIZE = 16 * 1024
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def validate_digest(value, label):
+    if not isinstance(value, str) or re.fullmatch(r'[0-9a-fA-F]{64}', value) is None:
+        raise ValueError(f'A full 64-hex SHA256 pin is required for {label}')
+    return value.lower()
+
+
+def offset_value(value):
+    if isinstance(value, bool):
+        raise ValueError('MPG file offsets must be integer byte offsets')
+    if isinstance(value, str):
+        try:
+            value = int(value, 0)
+        except ValueError as error:
+            raise ValueError('Invalid MPG file offset') from error
+    if not isinstance(value, int) or value < 0 or value % 4:
+        raise ValueError('MPG file offsets must be nonnegative four-byte-aligned integers')
+    return value
+
+
+def reconstruct_elf(data, expected_sha256, offsets):
+    # Validate ownership/version pin before interpreting any untrusted metadata.
+    expected_sha256 = validate_digest(expected_sha256, 'the owned ELF')
+    if sha256(data) != expected_sha256:
+        raise ValueError('Owned ELF SHA256 does not match the supplied pin')
+    if len(data) < 52 or data[:7] != b'\x7fELF\x01\x01\x01' or struct.unpack_from('<H', data, 18)[0] != 8:
+        raise ValueError('Expected a little-endian 32-bit MIPS ELF')
+    offsets = [offset_value(value) for value in offsets]
+    if not offsets or len(set(offsets)) != len(offsets):
+        raise ValueError('Supply a nonempty ordered list of distinct MPG file offsets')
+    # The game starts from cleared VU1 code memory. Ordered uploads overwrite
+    # bytes and wrap exactly as the VIF1 MPG implementation does.
+    code = bytearray(CODE_SIZE)
+    uploads = []
+    for offset in offsets:
+        if offset + 4 > len(data):
+            raise ValueError(f'MPG command exceeds ELF bounds at {offset:#x}')
+        command = struct.unpack_from('<I', data, offset)[0]
+        if ((command >> 24) & 0x7f) != 0x4a:
+            raise ValueError(f'Expected an MPG command at {offset:#x}')
+        destination = (command & 0x7ff) * 8
+        count = (command >> 16) & 255
+        size = (count or 256) * 8
+        payload_end = offset + 4 + size
+        if payload_end > len(data):
+            raise ValueError(f'MPG payload exceeds ELF bounds at {offset:#x}')
+        payload = data[offset + 4:payload_end]
+        first_size = min(size, CODE_SIZE - destination)
+        code[destination:destination + first_size] = payload[:first_size]
+        if first_size < size:
+            code[:size - first_size] = payload[first_size:]
+        uploads.append({'file_offset': offset, 'command': command,
+                        'destination': destination, 'bytes': size})
+    return bytes(code), uploads
+
+
+def read_elf(path, expected_sha256, offsets, metadata_path=None):
+    expected_code_sha256 = None
+    if metadata_path is not None:
+        if expected_sha256 is not None or offsets:
+            raise ValueError('Use metadata or explicit ELF SHA/offsets, not both')
+        metadata = json.loads(metadata_path.read_text(encoding='utf-8'))
+        if not isinstance(metadata, dict):
+            raise ValueError('MPG metadata must be a JSON object')
+        if (type(metadata.get('version')) is not int or metadata.get('version') != 1 or
+                metadata.get('unit') != 'VU1' or metadata.get('initialization') != 'zero' or
+                type(metadata.get('code_size')) is not int or metadata.get('code_size') != CODE_SIZE):
+            raise ValueError('Expected version 1 VU1 metadata with code_size 16384 and zero initialization')
+        expected_sha256 = metadata.get('elf_sha256')
+        uploads = metadata.get('uploads')
+        if not isinstance(uploads, list) or any(not isinstance(upload, dict) or set(upload) != {'header_offset'} for upload in uploads):
+            raise ValueError('MPG uploads must be an ordered list of header_offset objects')
+        offsets = [upload['header_offset'] for upload in uploads]
+        expected_code_sha256 = validate_digest(metadata.get('expected_image_sha256'), 'the reconstructed image')
+    data = path.read_bytes()
+    code, uploads = reconstruct_elf(data, expected_sha256, offsets)
+    if expected_code_sha256 is not None and sha256(code) != expected_code_sha256:
+        raise ValueError('Reconstructed code image SHA256 does not match metadata')
+    return code, {'kind': 'owned-elf-mpg', 'path': str(path.resolve()),
+                  'elf_sha256': sha256(data), 'initialization': 'zero',
+                  'ordered_uploads': uploads,
+                  'metadata_path': str(metadata_path.resolve()) if metadata_path else None}
