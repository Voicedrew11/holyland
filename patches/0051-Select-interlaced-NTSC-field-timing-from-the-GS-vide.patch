+    uint64_t fieldPeriodCycles(VBlankFieldPacer::Duration period)
+    {
+        const uint64_t ns = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(period).count());
+        return (ns * EeScheduler::kEeClockHz + 999999999ull) / 1000000000ull;
+    }
