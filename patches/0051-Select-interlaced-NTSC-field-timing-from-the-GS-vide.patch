     constexpr uint64_t kVBlankPeriodCycles = microsecondsToEeCycles(16667u);
     constexpr uint64_t kVBlankDurationCycles = microsecondsToEeCycles(500u);
     constexpr uint64_t kAlarmTickCycles = microsecondsToEeCycles(kAlarmTickMicroseconds);
@@ -1444,6 +1451,43 @@ void EeScheduler::dispatchIrq(bool dmac, uint32_t cause)
     }
 }
 
+void EeScheduler::setGsVideoMode(uint32_t interlaced, uint32_t videoMode)
+{
+    assertExecutor();
+    // Scope this correction to the confirmed interlaced NTSC mode. Other
+    // modes retain their existing pacing until their own timing is supported.
+    const VBlankFieldPacer::Duration period = (interlaced & 1u) != 0u && videoMode == 0x02u
+        ? VBlankFieldPacer::Duration{kInterlacedNtscPeriod}
+        : VBlankFieldPacer::Duration{kVBlankPeriod};
+    const auto oldPeriod = m_fieldPacer.period();
+    if (period == oldPeriod)
+        return;
+    const uint64_t oldCycles = fieldPeriodCycles(oldPeriod);
+    const uint64_t newCycles = fieldPeriodCycles(period);
+    m_fieldPacer.setPeriod(period);
+    {
+        std::lock_guard lock(m_eventMutex);
+        for (ScheduledEvent &item : m_deadlines)
+        {
+            if (item.event.type != EeEventType::VBlankStart)
+                continue;
+            // Only the upcoming field changes mode. Prior Ends, alarm/IRQ
+            // deadlines and emitted guest ticks remain on their original path.
+            assert(item.deadlineCycle >= oldCycles);
+            item.deadlineCycle = item.deadlineCycle - oldCycles + newCycles;
+            item.hostDeadline = m_vsyncTick == 0u ? m_fieldPacer.firstStart()
+                : m_fieldPacer.nextStartAfter(
+                    m_fieldPacer.lastStart(static_cast<unsigned>(m_vsyncTick & 1u)),
+                    static_cast<unsigned>((m_vsyncTick + 1u) & 1u));
+        }
+        if (!m_vblankHandoffs.empty())
+            m_vblankHandoffExpiry = m_fieldPacer.lastStart(static_cast<unsigned>(m_vsyncTick & 1u)) + period * 2;
+        updateNextDeadline();
+    }
+    m_checkpointPending.store(true, std::memory_order_release);
+    m_eventCv.notify_one();
+}
+
 void EeScheduler::setVSyncFlag(uint32_t flagAddress, uint32_t tickAddress)
 {
     assertExecutor();
@@ -2102,7 +2146,7 @@ void EeScheduler::processDueDeadlines()
                 scheduleEvent(scheduled.deadlineCycle + kVBlankDurationCycles,
                               hostFieldStart + kVBlankDuration,
                               EeEvent{EeEventType::VBlankEnd, 0, m_vsyncTick});
-                scheduleEvent(scheduled.deadlineCycle + kVBlankPeriodCycles,
+                scheduleEvent(scheduled.deadlineCycle + fieldPeriodCycles(m_fieldPacer.period()),
                               m_fieldPacer.nextStartAfter(hostFieldStart, parity ^ 1u),
                               EeEvent{EeEventType::VBlankStart, 0, 0});
             }
@@ -2312,7 +2356,7 @@ void EeScheduler::addVBlankHandoff(const GuestThread &item)
 #if PS2X_VBLANK_HANDOFF
     const uint64_t sequence = item.invocations.empty() ? 0u : item.invocations.back().sequence;
     if (m_vblankHandoffs.empty())
-        m_vblankHandoffExpiry = m_fieldPacer.lastStart(static_cast<unsigned>(m_vsyncTick & 1u)) + kVBlankPeriod * 2;
+        m_vblankHandoffExpiry = m_fieldPacer.lastStart(static_cast<unsigned>(m_vsyncTick & 1u)) + m_fieldPacer.period() * 2;
     std::erase_if(m_vblankHandoffs, [&item](const VBlankHandoff &handoff)
         { return handoff.threadId == item.id; });
     m_vblankHandoffs.push_back({item.id, sequence});
