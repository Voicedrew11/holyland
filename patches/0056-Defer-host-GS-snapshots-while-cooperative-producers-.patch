diff --git a/ps2xRuntime/include/runtime/gs/gs_host_presentation_admission.h b/ps2xRuntime/include/runtime/gs/gs_host_presentation_admission.h
new file mode 100644
index 0000000..321122e
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_host_presentation_admission.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include "runtime/gs/gs_types.h"
+#include <atomic>
+#include <cstdlib>
+#include <cstdint>
+
+// Mutations and cache operations are protected by GS::m_stateMutex. Only the
+// producer-pending flag is shared independently with the host drawing thread.
+class GSHostPresentationAdmission
+{
+public:
+    void setProducerPending(bool pending) noexcept
+    { m_producerPending.store(pending, std::memory_order_release); }
+    bool producerPending() const noexcept
+    { return m_producerPending.load(std::memory_order_acquire); }
+    void noteMutation() noexcept
+    {
+        if (++m_mutationEpoch == 0u) m_hasRequest = false;
+    }
+    void reset() noexcept
+    {
+        ++m_resetEpoch;
+        noteMutation();
+        m_hasRequest = false;
+        setProducerPending(false);
+    }
+    uint64_t mutationEpoch() const noexcept { return m_mutationEpoch; }
+    uint64_t resetEpoch() const noexcept { return m_resetEpoch; }
+    bool unchanged(const GSPresentationRequest &request) const noexcept
+    {
+        return m_hasRequest && m_presentedEpoch == m_mutationEpoch &&
+            m_rawField == rawField() && sameRequest(m_request, request);
+    }
+    void commit(const GSPresentationRequest &request, uint64_t mutation) noexcept
+    {
+        m_request = request;
+        m_presentedEpoch = mutation;
+        m_rawField = rawField();
+        m_hasRequest = true;
+    }
+private:
+    static bool rawField() noexcept
+    {
+        const char *value = std::getenv("PS2X_NO_WEAVE");
+        return value && *value && *value != '0';
+    }
+    static bool sameFrame(const GSFrameReg &a, const GSFrameReg &b) noexcept
+    { return a.fbp == b.fbp && a.fbw == b.fbw && a.psm == b.psm && a.fbmsk == b.fbmsk; }
+    static bool sameRequest(const GSPresentationRequest &a, const GSPresentationRequest &b) noexcept
+    {
+        // Retain physical phase for every interlaced mode, even when the
+        // Vulkan bridge currently converts that mode to progressive pixels.
+        const bool samePhase = !(a.smode2 & 1u) || ((a.vsyncTick ^ b.vsyncTick) & 1u) == 0u;
+        return samePhase && a.pmode == b.pmode && a.smode2 == b.smode2 &&
+            a.dispfb1 == b.dispfb1 && a.display1 == b.display1 &&
+            a.dispfb2 == b.dispfb2 && a.display2 == b.display2 && a.bgcolor == b.bgcolor &&
+            sameFrame(a.contextFrames[0], b.contextFrames[0]) &&
+            sameFrame(a.contextFrames[1], b.contextFrames[1]) &&
+            sameFrame(a.preferredSource, b.preferredSource) &&
+            a.preferredDestFbp == b.preferredDestFbp && a.hasPreferredSource == b.hasPreferredSource;
+    }
+    std::atomic<bool> m_producerPending{false};
+    uint64_t m_mutationEpoch = 0u;
+    uint64_t m_resetEpoch = 0u;
+    uint64_t m_presentedEpoch = 0u;
+    GSPresentationRequest m_request{};
+    bool m_rawField = false;
+    bool m_hasRequest = false;
+};
diff --git a/ps2xRuntime/src/lib/gs/gs_frontend.cpp b/ps2xRuntime/src/lib/gs/gs_frontend.cpp
