     m_prim = {};
     m_primRegister = {};
@@ -537,25 +538,36 @@ GSPresentationRequest GS::buildPresentationRequestUnlocked() const
     return request;
 }
 
-void GS::latchHostPresentationFrame()
+bool GS::latchHostPresentationFrame()
 {
+    // Only the executor publishes this atomic gate. Reading its VIF containers
+    // or VU job state here would race the producer.
+    if (m_hostAdmission.producerPending()) return false;
     GSPresentationRequest request{};
+    uint64_t mutation = 0u, reset = 0u;
     {
         std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+        if (m_hostAdmission.producerPending()) return false;
         if (!m_backend || !m_privRegs)
         {
             std::lock_guard<std::mutex> presentationLock(m_presentationMutex);
             m_hostPresentationFrame.clear();
             m_hasHostPresentationFrame = false;
             m_hostPresentationWidth = m_hostPresentationHeight = 0u;
-            return;
+            return true;
         }
         request = buildPresentationRequestUnlocked();
+        if (m_hostAdmission.unchanged(request)) return true;
+        mutation = m_hostAdmission.mutationEpoch();
+        reset = m_hostAdmission.resetEpoch();
     }
 
     PresentationFrame frame{};
     {
         std::lock_guard<std::mutex> backendLock(m_backendLifetimeMutex);
+        // Producer admission can change after the state snapshot. Deferring
+        // here avoids a needless host flush while the next job is beginning.
+        if (m_hostAdmission.producerPending()) return false;
         if (m_backend)
         {
             m_backend->Flush();
@@ -570,6 +582,10 @@ void GS::latchHostPresentationFrame()
     const uint32_t width = frame.width;
     const uint32_t height = frame.height;
     const bool usedPreferred = frame.usedPreferred;
+    std::lock_guard<std::recursive_mutex> stateLock(m_stateMutex);
+    // Reset/replacement can finish while a submitted snapshot is being read.
+    // A pre-reset image must never resurrect the invalidated host frame.
+    if (m_hostAdmission.resetEpoch() != reset) return false;
     {
         std::lock_guard<std::mutex> presentationLock(m_presentationMutex);
         m_hostPresentationFrame = std::move(frame.pixels);
@@ -580,12 +596,12 @@ void GS::latchHostPresentationFrame()
         m_hostPresentationUsedPreferred = usedPreferred;
         m_hasHostPresentationFrame = hasFrame;
     }
-
+    // A later mutation keeps the captured epoch old, forcing another snapshot.
+    // Cache empty results only while their complete request remains unchanged.
+    m_hostAdmission.commit(request, mutation);
     if (hasFrame)
-    {
-        std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
         recordPresentDebugEventUnlocked(displayFbp, sourceFbp, width, height, usedPreferred);
-    }
+    return true;
 }
 
 bool GS::copyLatchedHostPresentationFrame(std::vector<uint8_t> &outPixels,
@@ -1451,6 +1467,7 @@ void GS::writeRegisterUnlocked(uint8_t regAddr, uint64_t value)
             command.trxpos = m_trxpos;
             command.trxreg = m_trxreg;
             command.direction = m_trxdir;
+            if (command.direction == 2u) m_hostAdmission.noteMutation();
             m_backend->BeginTransfer(command);
         }
         recordTransferDebugEventUnlocked();
@@ -1642,6 +1659,7 @@ void GS::vertexKick(bool drawing)
             GSTrace::setTick(traceTick);
             GSTrace::drawPrimitive(batch, traceTick);
         }
+        m_hostAdmission.noteMutation();
         m_backend->Submit(batch);
         recordDrawDebugEventUnlocked(needed);
     }
@@ -1676,20 +1694,27 @@ void GS::vertexKick(bool drawing)
 void GS::processImageData(const uint8_t *data, uint32_t sizeBytes)
 {
     if (m_backend)
+    {
+        m_hostAdmission.noteMutation();
         m_backend->UploadImage(data, sizeBytes);
+    }
 }
 
 
 bool GS::clearFramebufferContext(uint32_t contextIndex, uint32_t rgba)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
-    return m_backend && m_backend->ClearFramebuffer(m_ctx[(contextIndex != 0u) ? 1 : 0], rgba);
+    const bool cleared = m_backend && m_backend->ClearFramebuffer(m_ctx[(contextIndex != 0u) ? 1 : 0], rgba);
+    if (cleared) m_hostAdmission.noteMutation();
+    return cleared;
 }
 
 bool GS::clearActiveFramebuffer(uint32_t rgba)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
-    return m_backend && m_backend->ClearFramebuffer(activeContext(), rgba);
+    const bool cleared = m_backend && m_backend->ClearFramebuffer(activeContext(), rgba);
+    if (cleared) m_hostAdmission.noteMutation();
+    return cleared;
 }
 
 uint32_t GS::consumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
@@ -1723,6 +1748,13 @@ void GS::setRasterBackend(std::unique_ptr<GSRasterBackend> backend)
         }
     }
 
+    m_hostAdmission.reset();
+    {
+        std::lock_guard<std::mutex> presentationLock(m_presentationMutex);
+        m_hostPresentationFrame.clear();
+        m_hasHostPresentationFrame = false;
+        m_hostPresentationWidth = m_hostPresentationHeight = 0u;
+    }
     m_backend = std::move(backend);
     m_backend->Initialize(m_localMemoryStorage, m_localMemorySize);
 }
@@ -1737,7 +1769,10 @@ void GS::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     if (m_backend)
+    {
+        m_hostAdmission.noteMutation();
         m_backend->WriteVram(psm, base, bw, x, y, value);
+    }
 }
 
