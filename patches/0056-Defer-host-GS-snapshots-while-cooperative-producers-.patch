diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 84328eb..ea32437 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -709,6 +709,7 @@ static void UploadFrame(Texture2D &tex, PS2Runtime *rt, uint32_t &outWidth, uint
 {
     static uint64_t s_lastPresentationTick = std::numeric_limits<uint64_t>::max();
     static bool s_hasLatchedInitialFrame = false;
+    static uint64_t s_lastPresentationReset = std::numeric_limits<uint64_t>::max();
     static uint32_t s_lastDisplayFbp = std::numeric_limits<uint32_t>::max();
     static uint32_t s_lastSourceFbp = std::numeric_limits<uint32_t>::max();
     static bool s_lastPreferred = false;
@@ -718,13 +719,35 @@ static void UploadFrame(Texture2D &tex, PS2Runtime *rt, uint32_t &outWidth, uint
     static std::vector<uint8_t> s_scratch;
     static std::vector<uint8_t> s_uploadBuffer(DEFAULT_FB_SIZE, 0u);
 
+    const uint64_t reset = rt->gs().hostPresentationResetEpoch();
+    if (reset != s_lastPresentationReset)
+    {
+        s_lastPresentationReset = reset;
+        s_hasLatchedInitialFrame = false;
+        // The native texture belongs to the old GS epoch too. Blank it once,
+        // then retain that neutral image if the first new latch is deferred.
+        std::fill(s_uploadBuffer.begin(), s_uploadBuffer.end(), 0u);
+        UpdateTexture(tex, s_uploadBuffer.data());
+        s_hasUploadedFrame = true;
+        s_lastWidth = FB_WIDTH;
+        s_lastHeight = DEFAULT_DISPLAY_HEIGHT;
+    }
     const uint64_t currentTick = rt->eeScheduler().currentVSyncTick();
     const bool needsLatch = !s_hasLatchedInitialFrame || currentTick != s_lastPresentationTick;
     if (needsLatch)
     {
-        rt->gs().latchHostPresentationFrame();
-        s_lastPresentationTick = currentTick;
-        s_hasLatchedInitialFrame = true;
+        const bool admitted = rt->gs().latchHostPresentationFrame();
+        if (admitted)
+        {
+            s_lastPresentationTick = currentTick;
+            s_hasLatchedInitialFrame = true;
+        }
+        else if (s_hasUploadedFrame)
+        {
+            outWidth = s_lastWidth != 0u ? s_lastWidth : FB_WIDTH;
+            outHeight = s_lastHeight != 0u ? s_lastHeight : DEFAULT_DISPLAY_HEIGHT;
+            return;
+        }
     }
     else if (s_hasUploadedFrame)
     {
@@ -1021,6 +1044,7 @@ bool PS2Runtime::syncCoreSubsystems()
                                          (cpuContext->vu0_fbrst & (1u << 10)) != 0u;
                                      m_vu1.state().tBitEnabled =
                                          (cpuContext->vu0_fbrst & (1u << 11)) != 0u;
+                                     m_gs.setHostPresentationProducerPending(true);
                                      if (!m_vu1.beginExecute(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE,
                                                    m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
                                                    m_gs, &m_memory, startPC, top, itop, 65536))
@@ -1037,12 +1061,14 @@ bool PS2Runtime::syncCoreSubsystems()
                                          (cpuContext->vu0_fbrst & (1u << 10)) != 0u;
                                      m_vu1.state().tBitEnabled =
                                          (cpuContext->vu0_fbrst & (1u << 11)) != 0u;
+                                     m_gs.setHostPresentationProducerPending(true);
                                      if (!m_vu1.beginResume(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE,
                                                   m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
                                                   m_gs, &m_memory, top, itop, 65536))
                                          throw std::logic_error("cooperative VIF1 MSCNT overlaps active VU service");
                                      publishVu1Control(*cpuContext); });
-    m_memory.setVu1CooperativeCallbacks([this] { return m_vu1.jobActive(); }, [this] { m_vu1.cancelJob(); });
+    m_memory.setVu1CooperativeCallbacks([this] { return m_vu1.jobActive(); }, [this]
+        { m_vu1.cancelJob(); m_gs.setHostPresentationProducerPending(false); });
     m_memory.cancelVif1Work();
     resetIop();
     m_vu0.reset();
@@ -2860,7 +2886,19 @@ void PS2Runtime::serviceCooperativeVif1(uint32_t quantum)
     // interpreter while its outer step still owns captured issue state.
     if (m_servicingCooperativeVif1) return;
     m_servicingCooperativeVif1 = true;
-    struct ServiceScope { bool &flag; ~ServiceScope() { flag = false; } } scope{m_servicingCooperativeVif1};
+    m_gs.setHostPresentationProducerPending(true);
+    struct ServiceScope
+    {
+        PS2Runtime &runtime;
+        ~ServiceScope()
+        {
+            // Waiting for new input is a safe display boundary; a continuously
+            // incomplete stream must not permanently starve host presentation.
+            const bool producing = runtime.m_memory.vif1WorkPending() && runtime.m_memory.vif1Runnable();
+            runtime.m_gs.setHostPresentationProducerPending(producing);
+            runtime.m_servicingCooperativeVif1 = false;
+        }
+    } scope{*this};
     m_memory.processPendingTransfers();
     if (m_vu1.jobActive())
     {
