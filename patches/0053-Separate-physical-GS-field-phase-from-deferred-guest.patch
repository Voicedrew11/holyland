+void EeScheduler::synchronizePhysicalClock() noexcept
+{
+    if (std::this_thread::get_id() != m_executorThread)
+        return;
+    const auto now = std::chrono::steady_clock::now();
+    auto &gs = m_runtime.memory().gs();
+    const uint64_t oldSlot = gs.vsyncTick.load(std::memory_order_acquire);
+    const uint64_t physicalSlot = m_fieldPacer.advancePhysicalPhase(now, oldSlot);
+    if (physicalSlot != oldSlot)
+    {
+        gs.vsyncTick.store(physicalSlot, std::memory_order_release);
+        if ((physicalSlot & 1u) != 0u)
+            gs.csr.fetch_or(0x2000ull, std::memory_order_acq_rel);
+        else
+            gs.csr.fetch_and(~0x2000ull, std::memory_order_acq_rel);
+    }
+
+    // Sampling only publishes physical phase. Independent recurring Start/End
+    // deadlines latch their old cause once at the outer dispatch safepoint.
+    // This MMIO hook neither allocates events nor enters guest callbacks.
+}
+
 void EeScheduler::synchronizeTimerClock() noexcept
 {
-    if (m_timerClockSynchronizing || std::this_thread::get_id() != m_executorThread ||
