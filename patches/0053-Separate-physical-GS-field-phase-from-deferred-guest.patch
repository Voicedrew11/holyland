@@ -34,6 +35,37 @@ public:
 
     TimePoint firstStart() const { return m_epoch + m_period; }
 
+    // This alternative clock records nominal physical boundaries. A late
+    // observation samples one latest slot; it never emits a backlog of slots.
+    TimePoint physicalBoundary() const
+    {
+        TimePoint latest = m_epoch;
+        for (unsigned parity = 0; parity < 2u; ++parity)
+            if (m_hasLastStart[parity] && m_lastStart[parity] > latest)
+                latest = m_lastStart[parity];
+        return latest;
+    }
+
+    TimePoint nextPhysicalBoundary() const { return physicalBoundary() + m_period; }
+    TimePoint physicalBlankEnd() const { return physicalBoundary() + m_blankDuration; }
+
+    uint64_t advancePhysicalPhase(TimePoint now, uint64_t currentSlot)
+    {
+        const TimePoint anchor = physicalBoundary();
+        if (now <= anchor)
+            return currentSlot;
+        const auto skipped = (now - anchor) / m_period;
+        if (skipped <= 0)
+            return currentSlot;
+        const uint64_t slots = static_cast<uint64_t>(skipped);
+        const TimePoint latest = anchor + m_period * skipped;
+        const uint64_t nextSlot = currentSlot + slots;
+        recordStart(latest, static_cast<unsigned>(nextSlot & 1u));
+        if (slots > 1u)
+            recordStart(latest - m_period, static_cast<unsigned>((nextSlot - 1u) & 1u));
+        return nextSlot;
+    }
+
     void recordStart(TimePoint emittedStart, unsigned parity)
     {
         assert(parity < 2u && emittedStart >= m_epoch);
