+/* PC: which threads run an event, for quick saves (Script_EventRunning, game/quicksave.c). A save image holds
+   the world's flags but no script thread, so a save taken while a script the game set off in play is still
+   running keeps what the script has done so far and loses the rest of it. The Dark Knight's door on map 036
+   (use script 4107) opens, waits for the player to walk 390 away, then closes and, if he went in, shows the
+   text and sets the knight on (map script flag 36:11); a save taken while it was open came back with the door
+   open and nothing left to close it, and the knight held by the map's start script (9005) for good.
+   An event's thread is one the game starts from outside the interpreter (an object's use, item-use or break
+   script, a person's talk or item script, a death script, an item's pickup script), not the map's start
+   script (0x7FFF). Threads a script starts (command 2) are not counted: the map's start script starts its own
+   loops, which it starts again from the flags when the map is entered, and events start some of the same
+   (map 027's item-use 5001 starts 9003, a light loop that never ends; map 102's 4201-4203 start timers that
+   run for minutes), so counting them would hold quick saves for good. In all 64 maps every event script that
+   waits does so for something the player does soon: a door's for him to walk away, map 002's eighth death
+   (3004 and the like) for him to walk off and open door 104. */
+static u8 thread_is_event[24];
+static int stepping_threads; /* Script_UpdateAll is stepping the threads */
+
+static void Script_MarkStarted(int index, int script_id) {
+    thread_is_event[index] = !stepping_threads && script_id != 0x7FFF;
+}
+
+int Script_EventRunning(void) {
+    int i;
+
+    for (i = 0; i < 24; i++) {
+        if (threads[i].script_id != 0 && thread_is_event[i]) {
+            return threads[i].script_id;
+        }
+    }
+    return 0;
+}
