+    if (!alreadyLatched) queueCompletedDmacCause(1u);
+    if (m_vif1DmaEnds.empty())
+    {
+        m_ioRegisters[0x10009000u] &= ~0x100u;
+        m_ioRegisters[0x10009020u] = 0u;
+    }
