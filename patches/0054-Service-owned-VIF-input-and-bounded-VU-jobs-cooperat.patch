+
+void PS2Runtime::waitCooperativeVif1(R5900Context *ctx, uint8_t *rdram, bool dmaOnly)
+{
+    if (!(dmaOnly ? m_memory.vif1DmaBusy() : m_memory.vif1WorkPending() || m_memory.gifPathsBusy())) return;
