+    const bool alreadyLatched = (m_ioRegisters[dstatAddress] & 2u) != 0u;
+    uint32_t dstat = m_ioRegisters[dstatAddress] | 2u;
+    dstat = (dstat & ~(1u << 31)) | (((dstat & 0x3FFu) & ((dstat >> 16u) & 0x3FFu)) ? (1u << 31) : 0u);
