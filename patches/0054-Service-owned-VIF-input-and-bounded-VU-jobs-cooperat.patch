+void PS2Runtime::serviceCooperativeVif1(uint32_t quantum)
+{
+    // Throwing-capable, executor-only dispatcher service. No guest function is
+    // entered by the parser/VU/GIF work; resulting causes are queued afterward.
+    // Callbacks may reset/queue a new epoch, but cannot recursively enter the
+    // interpreter while its outer step still owns captured issue state.
+    if (m_servicingCooperativeVif1) return;
+    m_servicingCooperativeVif1 = true;
+    struct ServiceScope { bool &flag; ~ServiceScope() { flag = false; } } scope{m_servicingCooperativeVif1};
+    m_memory.processPendingTransfers();
