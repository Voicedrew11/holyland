+            // owned input. DMA may retire at that FIFO boundary while VIF
+            // remains waiting for the following payload chunk. No launch or
+            // command-register mutation was performed by incomplete input.
+            if (m_vif1WaitingForInput) retire(m_vif1InputBase + m_vif1Input.size());
+        }
+        if (m_vif1Cursor == m_vif1Input.size())
+        {
+            m_vif1InputBase += m_vif1Cursor;
+            m_vif1Input.clear(); m_vif1Cursor = 0;
+        }
