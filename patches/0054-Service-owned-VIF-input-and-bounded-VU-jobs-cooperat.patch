+    if (!m_vif1Servicing) { m_vif1Input.clear(); m_vif1Cursor = 0; m_vif1InputBase = 0; }
+    m_vif1Incoming.clear(); m_vif1AcceptedBytes = 0;
+    m_vif1WaitingForInput = false;
+    m_vif1DmaEnds.clear(); m_pendingVif1Transfers.clear();
+    m_ioRegisters[0x10009000u] &= ~0x100u;
+    m_ioRegisters[0x10009020u] = 0u;
 }
