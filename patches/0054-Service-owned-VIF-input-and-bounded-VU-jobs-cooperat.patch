index 86cbadc..abf6393 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -386,6 +386,28 @@ public:
     uint32_t reserveAsyncCallbackStack(uint32_t size, uint32_t alignment = 16u);
 
     void drainCompletedDmacHandlers(uint8_t *rdram);
+    bool cooperativeVif1Pending() const noexcept { return m_memory.vif1WorkPending() || !m_vif1BarrierWaits.empty(); }
+    bool cooperativeVif1Runnable() const noexcept
+    {
+        if (m_memory.vif1Runnable()) return true;
+        for (const auto &wait : m_vif1BarrierWaits)
+            if (wait.epoch != m_memory.vif1Epoch() || (wait.dmaOnly ? !m_memory.vif1DmaBusy() : !m_memory.vif1WorkPending() && !m_memory.gifPathsBusy()))
+                return true;
+        return false;
+    }
+    void serviceCooperativeVif1(uint32_t quantum = 256u);
+    void publishVu1Control(R5900Context &context) const noexcept
+    {
+        context.vu0_vpu_stat = (context.vu0_vpu_stat & ~0x0700u) |
+            (m_vu1.jobActive() ? 0x0100u : 0u) |
+            (m_vu1.state().stoppedByD ? 0x0200u : 0u) |
+            (m_vu1.state().stoppedByT ? 0x0400u : 0u);
+    }
+    void waitCooperativeVif1(R5900Context *ctx, uint8_t *rdram, bool dmaOnly);
+    struct Vif1BarrierWait { uint64_t token; uint64_t epoch; bool dmaOnly; };
+    std::vector<Vif1BarrierWait> m_vif1BarrierWaits;
+    bool m_servicingCooperativeVif1 = false;
+    uint64_t m_nextVif1WaitToken = 0u;
 
     void requestStop();
     bool isStopRequested() const;
