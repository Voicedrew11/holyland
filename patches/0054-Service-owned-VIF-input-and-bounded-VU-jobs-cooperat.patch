+    m_vif1Servicing = true;
+    const uint64_t serviceEpoch = m_vif1Epoch;
+    try
+    {
+        while (!m_vif1Incoming.empty())
+        {
+            auto incoming = std::move(m_vif1Incoming.front());
+            m_vif1Incoming.pop_front();
+            m_vif1Input.insert(m_vif1Input.end(), incoming.begin(), incoming.end());
+        }
+        // Retire the previous transfer before beginning a following transfer's
+        // MSCAL. Its completed VU barrier must not be attached to a later job.
+        const auto retire = [this](uint64_t consumed)
+        {
+            while (!m_vif1DmaEnds.empty() && m_vif1DmaEnds.front() <= consumed)
+            {
+                m_vif1DmaEnds.pop_front();
+                completeVif1Dma();
+            }
+        };
+        retire(m_vif1InputBase + m_vif1Cursor);
+        const auto left = static_cast<uint32_t>(m_vif1Input.size() - m_vif1Cursor);
+        if (left) m_vif1Cursor += processVIF1Commands(m_vif1Input.data() + m_vif1Cursor, left);
+        if (serviceEpoch != m_vif1Epoch)
+        {
+            // Callback reset kept the active byte allocation alive until the
+            // parser returned. Discard its old cursor; new incoming data stays
+            // owned by the new epoch and will be consumed at the next service.
+            m_vif1Input.clear(); m_vif1Cursor = 0; m_vif1InputBase = 0;
+            m_vif1Servicing = false;
