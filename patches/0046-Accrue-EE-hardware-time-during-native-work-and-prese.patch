+    constexpr uint64_t kTimerClockCreditTag = 0x54494D4500000000ull;
+    bool wallClockCreditBlocked(uint32_t pendingTimers,
+            const std::deque<GuestInvocation> &pendingInvocations,
+            const std::unordered_map<int, GuestThread> &threads) noexcept
+    {
+        if (pendingTimers != 0u)
+            return true;
+        const auto timerInterrupt = [](const GuestInvocation &invocation)
+        {
+            return invocation.kind == GuestInvocationKind::Interrupt &&
+                (invocation.tag & 0xFFFFFFFFFFFFFFFCull) == kTimerClockCreditTag;
+        };
+        if (std::any_of(pendingInvocations.begin(), pendingInvocations.end(), timerInterrupt))
+            return true;
+        for (const auto &[id, owner] : threads)
+        {
+            (void)id;
+            // A handler which explicitly blocks cannot retain a synthetic-clock
+            // hold: its wait needs physical events. Normal instruction accounting
+            // is always active, including inside interrupt and nested functions.
+            if ((owner.status == EeThreadStatus::Running || owner.status == EeThreadStatus::Ready) &&
+                std::any_of(owner.invocations.begin(), owner.invocations.end(), timerInterrupt))
+                return true;
+        }
+        return false;
+    }
