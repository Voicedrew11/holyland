index f1bdee0..b94f025 100644
--- a/ps2xRuntime/include/runtime/vblank_field_pacer.h
+++ b/ps2xRuntime/include/runtime/vblank_field_pacer.h
@@ -41,21 +41,17 @@ public:
     TimePoint nextStartAfter(TimePoint emittedStart, unsigned nextParity) const
     {
         assert(nextParity < 2u && emittedStart >= m_epoch);
-        // Keep a persistent nominal phase. Drop already missed host slots;
-        // never queue them as extra guest events. Strictly pass this field's
-        // End so a new Start cannot overtake its End in the host deadline gate.
-        const TimePoint afterEnd = emittedStart + m_blankDuration;
-        const auto nextSlot = (afterEnd - m_epoch) / m_period + 1;
-        TimePoint next = m_epoch + m_period * nextSlot;
-        if (m_hasLastStart[nextParity])
-        {
-            const TimePoint parityLimit = m_lastStart[nextParity] + m_period * 2;
-            if (next < parityLimit)
-                next = parityLimit;
-        }
-        // Do not round the parity limit up to another nominal phase slot:
-        // that would reintroduce a whole unnecessary field of waiting.
-        return next;
+        // The first unseen parity keeps the original full field spacing.
+        if (!m_hasLastStart[nextParity])
+            return emittedStart + m_period;
+
+        // Once both parities have emitted, retain their independent cadence
+        // without rounding late work to a host phase grid. No skipped host
+        // interval creates another guest event. Pass this field's End by one
+        // clock-duration tick so a new Start cannot overtake its End.
+        const TimePoint afterEnd = emittedStart + m_blankDuration + Duration{1};
+        const TimePoint parityLimit = m_lastStart[nextParity] + m_period * 2;
+        return afterEnd < parityLimit ? parityLimit : afterEnd;
     }
 
