{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows, clang (llvm-mingw or LLVM's clang)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, gcc",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, clang",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "KF4_FRAME_POINTERS": "OFF", "KF4_LTO": "ON" }
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows, clang, release (LTO, no frame pointers)",
      "inherits": [ "release", "windows-clang" ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux, gcc, release (LTO, no frame pointers)",
      "inherits": [ "release", "linux-gcc" ]
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux, clang, release (LTO, no frame pointers)",
      "inherits": [ "release", "linux-clang" ]
    }
  ],
  "buildPresets": [
    { "name": "windows-clang", "configurePreset": "windows-clang" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" }
  ]
}
