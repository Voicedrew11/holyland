/* The player menu's look: dark iron and amber. A sidebar with the Holyland logo and the sections, the section's rows,
   the focused row's help; the keys along the bottom. Windows of charcoal in a double iron frame with bracketed
   corners; titles in Cinzel in amber over an ornamented rule; the chosen line lit by an amber edge and glow; text in
   bone white. One accent (amber) throughout; ember only for warnings and a key being listened for. Only borders,
   colours, straight gradients and the menu's alpha masks (port/ui/ui_render.hpp draws no shaders, layers or
   transforms; the corners and rules are masks made by tools/ui_ornaments.py and tools/ui_masks.py).

   Colours:  window #13110f to #070606   sidebar #181512 to #0a0908   frame #6b6255 / #2a2620   amber #d4a95a
             text #e2dccf   dim #948b7c   off #5e574c   key #4a443a   ember #c46a4a   chosen amber edge, #d4a95a glow */

/* (RmlUi has no default style sheet: every element is inline until it says otherwise) */
div, h2, p {
	display: block;
}

body {
	display: block;
	font-family: Spectral;
	font-weight: normal;
	font-size: 17dp;
	color: #e2dccf;
	width: 100%;
	height: 100%;
}

#shade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#000000a8 #000000d8);
}

/* ---- While the menu is closed: only the hint of the keys that open it --------------------------------------------- */
body.closed #shade, body.closed #window {
	display: none;
}

#hint {
	display: none;
	position: absolute;
	top: 28dp;
	left: 50%;
	width: 420dp;
	margin-left: -210dp;
	box-sizing: border-box;
	padding: 7dp 14dp 7dp 14dp;
	text-align: center;
	font-size: 15dp;
	color: #bfb6a6;
	border: 1dp #6b6255;
	decorator: vertical-gradient(#13110fe8 #070606f0);
}

body.closed #hint.shown {
	display: block;
}

#hint key {
	margin: 0 5dp;
}

#hint-what {
	font-family: Cinzel;
	letter-spacing: 1dp;
	font-size: 17dp;
	color: #d4a95a;
	margin-left: 10dp;
}

/* ---- The window ---------------------------------------------------------------------------------------------------- */
#window {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 1200dp;
	height: 740dp;
	margin-left: -600dp;
	margin-top: -370dp;
}

#rule-outer {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 2dp #6b6255;
	padding: 4dp;
	decorator: vertical-gradient(#13110ff4 #070606f7);
}

#rule-inner {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 1dp #3a342b;
	border-top-color: #4a4337;
	padding-bottom: 10dp;
	decorator: vertical-gradient(#ffffff08 #ffffff00);
}

/* the window's iron corners, over the frame */
img.corner {
	display: block;
	position: absolute;
	width: 64dp;
	height: 64dp;
	image-color: #a8916a;
}

#corner-tl { left: -4dp; top: -4dp; }
#corner-tr { right: -4dp; top: -4dp; }
#corner-bl { left: -4dp; bottom: -4dp; }
#corner-br { right: -4dp; bottom: -4dp; }

#main {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

/* ---- The sidebar: the logo, the sections, the version ------------------------------------------------------------- */
#sidebar {
	display: flex;
	flex-direction: column;
	width: 270dp;
	box-sizing: border-box;
	padding: 22dp 0 12dp 0;
	border-right: 1dp #2a2620;
	decorator: vertical-gradient(#181512c8 #0a0908c8);
}

#crest {
	text-align: center;
	padding: 0 18dp 12dp 18dp;
	margin-bottom: 10dp;
}

#logo {
	width: 228dp;
	image-color: #d4a95a;
}

#subtitle {
	font-family: Cinzel;
	font-size: 13dp;
	color: #948b7c;
	margin-top: 6dp;
	letter-spacing: 3dp;
}

/* the ornamented rules: under the crest, centred; under the section's title, from the left */
#crest-rule {
	display: block;
	width: 220dp;
	height: 12dp;
	margin: 12dp auto 0 auto;
	image-color: #8a7344;
}

#heading-rule {
	display: block;
	width: 420dp;
	height: 8dp;
	margin-bottom: 10dp;
	image-color: #8a7344;
}

#tabs {
	flex: 1;
	overflow-y: auto;
}

tab {
	display: block;
	font-family: Cinzel;
	font-size: 17dp;
	letter-spacing: 1dp;
	color: #948b7c;
	padding: 6dp 18dp 6dp 26dp;
	border-left: 3dp #00000000;
}

tab:hover {
	color: #e2dccf;
}

tab.selected {
	color: #f2ead8;
	border-left: 3dp #d4a95a;
	decorator: horizontal-gradient(#d4a95a30 #d4a95a00);
}

/* the keys that change the section, above and below them */
tab.end {
	font-family: Spectral;
	font-size: 12dp;
	color: #5e574c;
	padding-top: 2dp;
	padding-bottom: 2dp;
}

#version {
	font-size: 12dp;
	color: #5e574c;
	padding: 8dp 18dp 0 26dp;
}

#version update {
	display: block;
	color: #d4a95a;
}

/* ---- The section: its title and rows ------------------------------------------------------------------------------- */
#content {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-width: 0;
	padding: 18dp 12dp 0 26dp;
}

#heading {
	font-family: Cinzel;
	font-weight: bold;
	font-size: 28dp;
	color: #d4a95a;
	letter-spacing: 2dp;
	padding-bottom: 4dp;
}

#rows {
	flex: 1;
	overflow-y: auto;
	padding-right: 10dp;
}

row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
	padding: 0 12dp 0 15dp;
	border-left: 3dp #00000000;
}

row.focused {
	decorator: horizontal-gradient(#d4a95a30 #d4a95a00);
	border-left: 3dp #d4a95a;
}

row.disabled {
	color: #5e574c;
}

row.heading {
	height: 30dp;
	margin-top: 10dp;
	padding-left: 2dp;
	font-family: Cinzel;
	font-size: 15dp;
	letter-spacing: 1dp;
	color: #b89350;
	border-bottom: 1dp #2a2620;
	border-left: 0;
}

row.heading.first {
	margin-top: 0;
}

label {
	display: block;
	flex: 1;
}

value {
	display: block;
	text-align: right;
	color: #e8dcc0;
	white-space: nowrap;
}

row.disabled value {
	color: #5e574c;
}

value.off {
	color: #948b7c;
}

row.action value {
	color: #948b7c;
	font-style: italic;
}

/* the arrows either side of a choice's or a number's value, on the focused row */
arrow {
	display: inline-block;
	width: 20dp;
	text-align: center;
	color: #d4a95a;
}

arrow.end {
	color: #00000000;
}

arrow:hover {
	color: #ffffff;
}

/* a number's place in its range */
bar {
	display: inline-block;
	width: 110dp;
	height: 3dp;
	margin-right: 10dp;
	vertical-align: middle;
	background-color: #2a2620;
}

fill {
	display: block;
	height: 3dp;
	background-color: #d4a95a;
}

note {
	display: inline;
	color: #c46a4a;
	font-size: 14dp;
	margin-right: 10dp;
}

/* ---- A binding's slots: two keys and a controller button ----------------------------------------------------------- */
row.binding label {
	white-space: nowrap;
	overflow: hidden;
}

row.binding.changed label {
	color: #e8dcc0;
}

slot {
	display: block;
	width: 92dp;
	margin-left: 4dp;
	padding: 2dp 4dp;
	text-align: center;
	font-size: 13dp;
	color: #bfb6a6;
	border: 1dp #2a2620;
	white-space: nowrap;
	overflow: hidden;
}

slot.empty {
	color: #5e574c;
}

slot:hover {
	border: 1dp #6b6255;
}

row.focused slot.chosen {
	color: #f2ead8;
	border: 1dp #d4a95a;
	decorator: vertical-gradient(#3a3020 #1c170f);
}

slot.listening, row.focused slot.listening {
	color: #f0b49a;
	border: 1dp #c46a4a;
	decorator: vertical-gradient(#4a2418 #24110b);
}

/* ---- A choice's list, open under its row --------------------------------------------------------------------------- */
row.open {
	margin-bottom: 0;
}

list {
	display: block;
	margin: 0 12dp 6dp 40dp;
	border: 1dp #6b6255;
	padding: 2dp;
	background-color: #0c0a09f8;
}

choice {
	display: block;
	padding: 4dp 12dp;
	border-left: 3dp #00000000;
}

choice.chosen {
	color: #d4a95a;
}

choice.highlighted {
	decorator: horizontal-gradient(#d4a95a30 #d4a95a00);
	border-left: 3dp #d4a95a;
}

/* ---- Help ---------------------------------------------------------------------------------------------------------- */
#help {
	width: 280dp;
	padding: 26dp 22dp 0 20dp;
	border-left: 1dp #2a2620;
	overflow-y: auto;
}

#help h2 {
	display: block;
	font-family: Cinzel;
	font-size: 19dp;
	color: #d4a95a;
	padding-bottom: 6dp;
	border-bottom: 1dp #2a2620;
	margin-bottom: 10dp;
}

#help p {
	display: block;
	font-size: 15dp;
	line-height: 1.45;
	color: #bfb6a6;
	margin-bottom: 8dp;
}

#help p.note {
	color: #c46a4a;
}

/* ---- What the keys do ---------------------------------------------------------------------------------------------- */
#prompts {
	text-align: center;
	font-size: 14dp;
	color: #948b7c;
	padding-top: 9dp;
	border-top: 1dp #2a2620;
}

prompt {
	display: inline-block;
	margin: 0 12dp;
}

key {
	display: inline-block;
	font-size: 13dp;
	color: #e2dccf;
	border: 1dp #4a443a;
	padding: 0 6dp;
	margin-right: 5dp;
}

/* ---- Scrollbars ---------------------------------------------------------------------------------------------------- */
scrollbarvertical {
	width: 5dp;
	margin-left: 4dp;
}

scrollbarvertical slidertrack {
	background-color: #00000000;
}

scrollbarvertical sliderbar {
	background-color: #4a443a;
}

scrollbarvertical sliderbar:hover {
	background-color: #6b6255;
}

/* ---- The game's own window (body.game-art: the disc has menu/menu.tmx) ---------------------------------------------
   King's Field IV's menu window, from its own textures on the player's disc (port/ui/game_menu_art.hpp): a soft black
   panel, and four wisps of ice added over it along the sides. The pieces and their places are those of the game's
   Settings screen (menu/option_para.dat: parts 0 and 31 to 34), at 1.5dp a game pixel (2 lines a game line). The
   sprites are in the textures' pixels; the edges are 0.75 bright (the parts' alpha, 0x60). */
@spritesheet game-panel {
	src: game-menu/10944-over.tex;
	game-panel: 0px 0px 128px 128px;
}

@spritesheet game-edges {
	src: game-menu/11584-add.tex;
	game-edge-side: 7px 54px 51px 458px;
	game-edge-bottom: 0px 1px 511px 56px;
}

@spritesheet game-edges-top {
	src: game-menu/11584-add_alpha.tex;
	game-edge-top: 0px 5px 510px 51px;
}

#game-frame {
	display: none;
}

body.game-art #game-frame {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#game-frame div {
	position: absolute;
	image-color: #ffffffc0;
}

#game-frame #game-panel {
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(game-panel);
	image-color: #000000;
}

#game-edge-left, #game-edge-right {
	top: 0;
	width: 32dp;
	height: 100%;
	decorator: image(game-edge-side);
}

#game-edge-left { left: 40dp; }
#game-edge-right { right: 44dp; }

#game-edge-top {
	top: 16dp;
	left: 9dp;
	right: 0;
	height: 36dp;
	decorator: image(game-edge-top);
}

#game-edge-bottom {
	bottom: 20dp;
	left: 0;
	right: 0;
	height: 36dp;
	decorator: image(game-edge-bottom flip-horizontal);
}

/* the window's own frame and corners give way to the game's; its rows stay inside the wisps */
body.game-art #rule-outer {
	position: relative;
	border-width: 0;
	padding: 52dp 76dp 56dp 72dp;
	decorator: none;
}

body.game-art #rule-inner {
	border-width: 0;
	decorator: none;
}

body.game-art img.corner {
	display: none;
}
