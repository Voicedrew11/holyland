/* The player menu's look: King's Field IV's own, cold iron and ice. A sidebar with the Holyland logo and the sections,
   the section's rows, the focused row's help; the keys along the bottom. The window is the game's own (its black panel
   and wisps of ice, read from the disc: "The game's own window" at the end); titles in Cinzel in ice blue; the
   chosen line lit by a soft glow fading in from the left, no bars or ornaments; text in cool white. One accent (ice) throughout, taken
   from the game's frame; ember only for warnings and a key being listened for. Only borders, colours, straight
   gradients and images (port/ui/ui_render.hpp draws no shaders, layers or transforms; the corners and the soft box are masks
   made by tools/ui_ornaments.py and tools/ui_masks.py).

   Colours:  window #0f1114 to #060708   sidebar #121418 to #08090b   frame #5a6474 / #22272f   ice #a8c4e8
             text #dde3ec   dim #8790a0   off #555d6b   key #3e4654   ember #c46a4a   chosen #a8c4e8 glow */

/* (RmlUi has no default style sheet: every element is inline until it says otherwise) */
div, h2, p {
	display: block;
}

body {
	display: block;
	font-family: Spectral;
	font-weight: normal;
	font-size: 17dp;
	color: #dde3ec;
	width: 100%;
	height: 100%;
}

#shade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#000000a8 #000000d8);
}

/* ---- While the menu is closed: only the hint of the keys that open it --------------------------------------------- */
body.closed #shade, body.closed #window {
	display: none;
}

/* a quiet plate in the top right corner: the keys of the input in use (F1, or the controller's L3 + R3 as pictures)
   and "Settings", on a dark soft box that fades into the picture (the soft box is defined with the game's window, below) */
#hint {
	display: none;
	position: absolute;
	top: 18dp;
	right: 18dp;
	padding: 12dp 34dp 12dp 34dp;
	white-space: nowrap;
	font-size: 15dp;
	color: #b4bccb;
	decorator: ninepatch(soft-box-outer, soft-box-inner, 18dp 30dp 18dp 30dp);
	image-color: #050607c8;
}

body.closed #hint.shown {
	display: block;
}

#hint key {
	margin-right: 0;
}

#hint pad {
	color: #c8d6ea;
	margin-right: 0;
	position: relative;
	top: -4dp; /* (as the prompts': centred on the words' capitals) */
}

#hint plus {
	color: #8790a0;
	margin: 0 3dp;
}

#hint what {
	font-family: Cinzel;
	letter-spacing: 1.5dp;
	font-size: 17dp;
	color: #a8c4e8;
	margin-left: 12dp;
}

/* ---- The window ---------------------------------------------------------------------------------------------------- */
#window {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 1200dp;
	height: 740dp;
	margin-left: -600dp;
	margin-top: -370dp;
}

#rule-outer {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 2dp #5a6474;
	padding: 4dp;
	decorator: vertical-gradient(#0f1114f4 #060708f7);
}

#rule-inner {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 1dp #2f3540;
	border-top-color: #3c4452;
	padding-bottom: 10dp;
	decorator: vertical-gradient(#ffffff08 #ffffff00);
}

/* the window's iron corners, over the frame */
img.corner {
	display: block;
	position: absolute;
	width: 64dp;
	height: 64dp;
	image-color: #8ea6c4;
}

#corner-tl { left: -4dp; top: -4dp; }
#corner-tr { right: -4dp; top: -4dp; }
#corner-bl { left: -4dp; bottom: -4dp; }
#corner-br { right: -4dp; bottom: -4dp; }

#main {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

/* ---- The sidebar: the logo, the sections, the version ------------------------------------------------------------- */
#sidebar {
	display: flex;
	flex-direction: column;
	width: 270dp;
	box-sizing: border-box;
	padding: 22dp 0 12dp 0;
	border-right: 1dp #22272f;
	decorator: vertical-gradient(#121418c8 #08090bc8);
}

#crest {
	text-align: center;
	padding: 0 18dp 12dp 18dp;
	margin-bottom: 10dp;
}

#logo {
	width: 228dp;
	image-color: #a8c4e8;
}

#subtitle {
	font-family: Cinzel;
	font-size: 13dp;
	color: #8790a0;
	margin-top: 6dp;
	margin-bottom: 12dp;
	letter-spacing: 3dp;
}

#tabs {
	flex: 1;
	overflow-y: auto;
}

tab {
	display: block;
	font-family: Cinzel;
	font-size: 17dp;
	letter-spacing: 1dp;
	color: #8790a0;
	padding: 6dp 18dp 6dp 26dp;
	border-left: 3dp #00000000;
}

tab:hover {
	color: #dde3ec;
}

tab.selected {
	color: #f0f4fa;
	decorator: horizontal-gradient(#a8c4e830 #a8c4e800);
}

/* the keys that change the section, above and below them */
tab.end {
	font-family: Spectral;
	font-size: 12dp;
	color: #555d6b;
	padding-top: 2dp;
	padding-bottom: 2dp;
}

#version {
	font-size: 12dp;
	color: #555d6b;
	padding: 8dp 18dp 0 26dp;
}

#version update {
	display: block;
	color: #a8c4e8;
}

/* ---- The section: its title and rows ------------------------------------------------------------------------------- */
#content {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-width: 0;
	padding: 18dp 12dp 0 26dp;
}

#heading {
	font-family: Cinzel;
	font-weight: bold;
	font-size: 28dp;
	color: #a8c4e8;
	letter-spacing: 2dp;
	padding-bottom: 4dp;
	margin-bottom: 18dp;
}

#rows {
	flex: 1;
	overflow-y: auto;
	padding-right: 10dp;
}

row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
	padding: 0 12dp 0 15dp;
	border-left: 3dp #00000000;
}

row.focused {
	decorator: horizontal-gradient(#a8c4e830 #a8c4e800);
}

row.disabled {
	color: #555d6b;
}

row.heading {
	height: 30dp;
	margin-top: 10dp;
	padding-left: 2dp;
	font-family: Cinzel;
	font-size: 15dp;
	letter-spacing: 1dp;
	color: #8fb0d8;
	border-bottom: 1dp #22272f;
	border-left: 0;
}

row.heading.first {
	margin-top: 0;
}

label {
	display: block;
	flex: 1;
}

value {
	display: block;
	text-align: right;
	color: #e4ecf6;
	white-space: nowrap;
}

row.disabled value {
	color: #555d6b;
}

value.off {
	color: #8790a0;
}

row.action value {
	color: #8790a0;
	font-style: italic;
}

/* the arrows either side of a choice's or a number's value, on the focused row */
arrow {
	display: inline-block;
	width: 20dp;
	text-align: center;
	color: #a8c4e8;
}

arrow.end {
	color: #00000000;
}

arrow:hover {
	color: #ffffff;
}

/* a number's place in its range */
bar {
	display: inline-block;
	width: 110dp;
	height: 3dp;
	margin-right: 10dp;
	vertical-align: middle;
	background-color: #22272f;
}

fill {
	display: block;
	height: 3dp;
	background-color: #a8c4e8;
}

note {
	display: inline;
	color: #c46a4a;
	font-size: 14dp;
	margin-right: 10dp;
}

/* ---- A binding's slots: two keys and a controller button ----------------------------------------------------------- */
row.binding label {
	white-space: nowrap;
	overflow: hidden;
}

row.binding.changed label {
	color: #e4ecf6;
}

slot {
	display: block;
	width: 92dp;
	margin-left: 4dp;
	padding: 2dp 4dp;
	text-align: center;
	font-size: 13dp;
	color: #b4bccb;
	border: 1dp #22272f;
	white-space: nowrap;
	overflow: hidden;
}

slot.empty {
	color: #555d6b;
}

slot:hover {
	border: 1dp #5a6474;
}

row.focused slot.chosen {
	color: #f0f4fa;
	border: 1dp #a8c4e8;
	decorator: vertical-gradient(#22324a #111a28);
}

slot.listening, row.focused slot.listening {
	color: #f0b49a;
	border: 1dp #c46a4a;
	decorator: vertical-gradient(#4a2418 #24110b);
}

/* ---- A choice's list, open under its row --------------------------------------------------------------------------- */
row.open {
	margin-bottom: 0;
}

list {
	display: block;
	margin: 0 12dp 6dp 40dp;
	border: 1dp #5a6474;
	padding: 2dp;
	background-color: #0a0b0df8;
}

choice {
	display: block;
	padding: 4dp 12dp;
	border-left: 3dp #00000000;
}

choice.chosen {
	color: #a8c4e8;
}

choice.highlighted {
	decorator: horizontal-gradient(#a8c4e830 #a8c4e800);
}

/* ---- Help ---------------------------------------------------------------------------------------------------------- */
#help {
	width: 280dp;
	padding: 26dp 22dp 0 20dp;
	border-left: 1dp #22272f;
	overflow-y: auto;
}

#help h2 {
	display: block;
	font-family: Cinzel;
	font-size: 19dp;
	color: #a8c4e8;
	padding-bottom: 6dp;
	border-bottom: 1dp #22272f;
	margin-bottom: 10dp;
}

#help p {
	display: block;
	font-size: 15dp;
	line-height: 1.45;
	color: #b4bccb;
	margin-bottom: 8dp;
}

#help p.note {
	color: #c46a4a;
}

/* ---- What the keys do ---------------------------------------------------------------------------------------------- */
#prompts {
	text-align: center;
	font-size: 14dp;
	color: #8790a0;
	padding-top: 9dp;
	border-top: 1dp #22272f;
}

prompt {
	display: inline-block;
	margin: 0 12dp;
}

key {
	display: inline-block;
	font-size: 13dp;
	color: #dde3ec;
	border: 1dp #3e4654;
	padding: 0 6dp;
	margin-right: 5dp;
}

/* A controller's button, as its picture (pad_glyphs.hpp): Kenney's fonts, one for each family of controllers */
pad {
	display: inline-block;
	font-size: 38dp; /* (Kenney's pictures fill about half the letter's height) */
	line-height: 14dp;
	vertical-align: middle;
	margin-right: 5dp;
}

prompt pad {
	color: #c8d6ea;
	position: relative;
	top: -4dp; /* (centred on the words' capitals, not their x-height) */
}

pad.xbox {
	font-family: pad-xbox;
}

pad.playstation {
	font-family: pad-playstation;
}

pad.nintendo {
	font-family: pad-nintendo;
}

tab.end pad {
	font-size: 34dp;
	line-height: 22dp;
	color: #8790a0;
	margin-right: 0;
}

slot pad {
	font-size: 32dp;
	vertical-align: -3dp;
	margin-right: 0;
}

/* ---- Scrollbars ---------------------------------------------------------------------------------------------------- */
scrollbarvertical {
	width: 5dp;
	margin-left: 4dp;
}

scrollbarvertical slidertrack {
	background-color: #00000000;
}

scrollbarvertical sliderbar {
	background-color: #3e4654;
}

scrollbarvertical sliderbar:hover {
	background-color: #5a6474;
}

/* ---- The game's own window (body.game-art: the disc has menu/menu.tmx) ---------------------------------------------
   King's Field IV's menu window, from its own textures on the player's disc (port/ui/game_menu_art.hpp): a soft black
   panel, and four wisps of ice added over it along the sides. The pieces and their places are those of the game's
   Settings screen (menu/option_para.dat: parts 0 and 31 to 34), at 1.5dp a game pixel (2 lines a game line). The
   sprites are in the textures' pixels; the edges are 0.75 bright (the parts' alpha, 0x60). */
@spritesheet game-panel {
	src: game-menu/10944-over.tex;
	game-panel: 0px 0px 128px 128px;
}

@spritesheet game-edges {
	src: game-menu/11584-add.tex;
	game-edge-side: 7px 54px 51px 458px;
	game-edge-bottom: 0px 1px 511px 56px;
}

@spritesheet game-edges-top {
	src: game-menu/11584-add_alpha.tex;
	game-edge-top: 0px 5px 510px 51px;
}

#game-frame {
	display: none;
}

body.game-art #game-frame {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#game-frame div {
	position: absolute;
	image-color: #ffffffc0;
}

#game-frame #game-panel {
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(game-panel);
	image-color: #000000;
}

#game-edge-left, #game-edge-right {
	top: 0;
	width: 32dp;
	height: 100%;
	decorator: image(game-edge-side);
}

#game-edge-left { left: 40dp; }
#game-edge-right { right: 44dp; }

#game-edge-top {
	top: 16dp;
	left: 9dp;
	right: 0;
	height: 36dp;
	decorator: image(game-edge-top);
}

#game-edge-bottom {
	bottom: 20dp;
	left: 0;
	right: 0;
	height: 36dp;
	decorator: image(game-edge-bottom flip-horizontal);
}

/* the window's own frame and corners give way to the game's; its rows stay inside the wisps */
body.game-art #rule-outer {
	position: relative;
	border-width: 0;
	padding: 52dp 76dp 56dp 72dp;
	decorator: none;
}

body.game-art #rule-inner {
	border-width: 0;
	decorator: none;
}

body.game-art img.corner {
	display: none;
}

/* the sidebar's shade fades into the game's panel on every side, with no dividing line: a soft box (soft_box.alpha,
   tools/ui_ornaments.py) drawn as a nine-patch, so the fade keeps its width; widest towards the rows, reaching past the
   sidebar to where the rows begin. It is drawn behind the sidebar's words (z-index -1 inside the sidebar). */
@spritesheet soft-box {
	src: soft_box.alpha;
	soft-box-outer: 0px 0px 136px 136px;
	soft-box-inner: 64px 64px 8px 8px;
}

#sidebar-shade {
	display: none;
}

body.game-art #sidebar {
	position: relative;
	z-index: 0;
	border-right-width: 0;
	decorator: none;
}

body.game-art #sidebar-shade {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: -26dp;
	bottom: 0;
	z-index: -1;
	decorator: ninepatch(soft-box-outer, soft-box-inner, 40dp 120dp 40dp 36dp);
	image-color: #0d0f12d0;
}

/* the chosen section, row and choice are lit by the same soft box, fading in from the left as the shade does */
body.game-art tab.selected,
body.game-art row.focused,
body.game-art choice.highlighted {
	decorator: ninepatch(soft-box-outer, soft-box-inner, 8dp 90dp 8dp 36dp);
	image-color: #a8c4e838;
}
