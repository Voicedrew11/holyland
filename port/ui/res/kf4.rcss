/* The player menu's look: King's Field IV's. Windows of near-black blue-grey with a double steel rule, as the
   game's own menus; titles in an old print face in pale gold; the chosen line a cold blue band; text in bone white.
   Only borders, colours and straight gradients (port/ui/ui_render.hpp draws no shaders, layers or transforms).

   Colours:  window #0a0f17 to #05080d   rule #7a879c / #263042   gold #c8b07a   text #d9d3c3
             dim #8d95a3   off #5a616d   band #2b4673 to #142238   band edge #b9c7e0   note #d39a6a */

/* (RmlUi has no default style sheet: every element is inline until it says otherwise) */
div, h2, p {
	display: block;
}

body {
	display: block;
	font-family: Spectral;
	font-weight: normal;
	font-size: 17dp;
	color: #d9d3c3;
	width: 100%;
	height: 100%;
}

#shade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#000000a8 #000000d8);
}

/* ---- The window ---------------------------------------------------------------------------------------------------- */
#window {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 1000dp;
	height: 680dp;
	margin-left: -500dp;
	margin-top: -340dp;
}

#rule-outer {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 1dp #7a879c;
	padding: 3dp;
	decorator: vertical-gradient(#0a0f17f2 #05080df5);
}

#rule-inner {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 1dp #263042;
	padding: 14dp 26dp 12dp 26dp;
}

#crest {
	text-align: center;
	padding-bottom: 6dp;
}

#title {
	font-family: "IM FELL English SC";
	font-size: 34dp;
	color: #c8b07a;
	letter-spacing: 2dp;
}

#subtitle {
	font-family: "IM FELL English";
	font-style: italic;
	font-size: 16dp;
	color: #8d95a3;
	margin-top: -4dp;
}

/* ---- Tabs ---------------------------------------------------------------------------------------------------------- */
#tabs {
	display: flex;
	flex-direction: row;
	justify-content: center;
	border-bottom: 1dp #263042;
	margin-bottom: 10dp;
}

tab {
	display: block;
	font-family: "IM FELL English SC";
	font-size: 19dp;
	color: #8d95a3;
	padding: 6dp 16dp 5dp 16dp;
	border-bottom: 2dp #00000000;
}

tab:hover {
	color: #d9d3c3;
}

tab.selected {
	color: #efe7d2;
	border-bottom: 2dp #c8b07a;
}

tab.end {
	font-family: Spectral;
	font-size: 13dp;
	color: #5a616d;
	padding-top: 10dp;
}

/* ---- The page: rows on the left, the focused row's help on the right ------------------------------------------------ */
#page {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

#rows {
	flex: 1;
	overflow-y: auto;
	padding-right: 10dp;
}

row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
	padding: 0 12dp 0 15dp;
	border-left: 3dp #00000000;
}

row.focused {
	decorator: horizontal-gradient(#2b4673e0 #14223850);
	border-left: 3dp #b9c7e0;
}

row.disabled {
	color: #5a616d;
}

row.heading {
	height: 30dp;
	margin-top: 10dp;
	padding-left: 2dp;
	font-family: "IM FELL English SC";
	font-size: 17dp;
	color: #c8b07a;
	border-bottom: 1dp #263042;
	border-left: 0;
}

row.heading.first {
	margin-top: 0;
}

label {
	display: block;
	flex: 1;
}

value {
	display: block;
	text-align: right;
	color: #e3dabf;
	white-space: nowrap;
}

row.disabled value {
	color: #5a616d;
}

value.off {
	color: #8d95a3;
}

row.action value {
	color: #8d95a3;
	font-style: italic;
}

/* the arrows either side of a choice's or a number's value, on the focused row */
arrow {
	display: inline-block;
	width: 20dp;
	text-align: center;
	color: #b9c7e0;
}

arrow.end {
	color: #00000000;
}

arrow:hover {
	color: #ffffff;
}

/* a number's place in its range */
bar {
	display: inline-block;
	width: 110dp;
	height: 3dp;
	margin-right: 10dp;
	vertical-align: middle;
	background-color: #263042;
}

fill {
	display: block;
	height: 3dp;
	background-color: #c8b07a;
}

note {
	display: inline;
	color: #d39a6a;
	font-size: 14dp;
	margin-right: 10dp;
}

/* ---- A choice's list, open under its row --------------------------------------------------------------------------- */
row.open {
	margin-bottom: 0;
}

list {
	display: block;
	margin: 0 12dp 6dp 40dp;
	border: 1dp #7a879c;
	padding: 2dp;
	background-color: #070b12f8;
}

choice {
	display: block;
	padding: 4dp 12dp;
	border-left: 3dp #00000000;
}

choice.chosen {
	color: #c8b07a;
}

choice.highlighted {
	decorator: horizontal-gradient(#2b4673e0 #14223850);
	border-left: 3dp #b9c7e0;
}

/* ---- Help ---------------------------------------------------------------------------------------------------------- */
#help {
	width: 300dp;
	margin-left: 18dp;
	padding: 4dp 0 0 18dp;
	border-left: 1dp #263042;
}

#help h2 {
	display: block;
	font-family: "IM FELL English";
	font-size: 22dp;
	color: #c8b07a;
	margin-bottom: 8dp;
}

#help p {
	display: block;
	font-size: 15dp;
	line-height: 1.45;
	color: #bdb6a6;
	margin-bottom: 8dp;
}

#help p.note {
	color: #d39a6a;
}

/* ---- What the keys do ---------------------------------------------------------------------------------------------- */
#prompts {
	text-align: center;
	font-size: 14dp;
	color: #8d95a3;
	padding-top: 8dp;
	border-top: 1dp #263042;
	margin-top: 8dp;
}

prompt {
	display: inline-block;
	margin: 0 12dp;
}

key {
	display: inline-block;
	font-size: 13dp;
	color: #d9d3c3;
	border: 1dp #4b566b;
	padding: 0 6dp;
	margin-right: 5dp;
}

/* ---- Scrollbars ---------------------------------------------------------------------------------------------------- */
scrollbarvertical {
	width: 5dp;
	margin-left: 4dp;
}

scrollbarvertical slidertrack {
	background-color: #11182400;
}

scrollbarvertical sliderbar {
	background-color: #4b566b;
}

scrollbarvertical sliderbar:hover {
	background-color: #7a879c;
}
