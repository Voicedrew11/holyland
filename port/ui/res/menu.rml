<rml>
<head>
	<title>Holyland</title>
	<link type="text/rcss" href="kf4.rcss"/>
</head>
<!-- The player menu (port/ui/player_ui.cpp fills #tabs, #version, #heading, #rows, #help and #prompts) -->
<body>
	<!-- the keys that open the menu, for the first seconds of play (player_ui.cpp: start_hint) -->
	<div id="hint"><key>F1</key>or<key>L3</key>+<key>R3</key><span id="hint-what">Holyland's settings</span></div>
	<div id="shade"></div>
	<div id="window">
		<div id="rule-outer">
			<div id="rule-inner">
				<div id="main">
					<div id="sidebar">
						<div id="crest">
							<img id="logo" src="logo.alpha"/>
							<div id="subtitle">King's Field IV</div>
						</div>
						<div id="tabs"></div>
						<div id="version"></div>
					</div>
					<div id="content">
						<div id="heading"></div>
						<div id="rows"></div>
					</div>
					<div id="help"></div>
				</div>
				<div id="prompts"></div>
			</div>
		</div>
	</div>
</body>
</rml>
