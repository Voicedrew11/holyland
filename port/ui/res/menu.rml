<rml>
<head>
	<title>Holyland</title>
	<link type="text/rcss" href="kf4.rcss"/>
</head>
<!-- The player menu (port/ui/player_ui.cpp fills #tabs, #version, #heading, #rows, #help and #prompts) -->
<body>
	<!-- the keys that open the menu, for the first seconds of play (player_ui.cpp: start_hint) -->
	<div id="hint"><key>F1</key>or<key>L3</key>+<key>R3</key><span id="hint-what">Holyland's settings</span></div>
	<div id="shade"></div>
	<div id="window">
		<!-- the game's own panel and frame, from the disc's menu/menu.tmx (body.game-art; port/ui/game_menu_art.hpp) -->
		<div id="game-frame">
			<div id="game-panel"></div>
			<div id="game-edge-top"></div>
			<div id="game-edge-bottom"></div>
			<div id="game-edge-left"></div>
			<div id="game-edge-right"></div>
		</div>
		<div id="rule-outer">
			<div id="rule-inner">
				<div id="main">
					<div id="sidebar">
						<div id="crest">
							<img id="logo" src="logo.alpha"/>
							<div id="subtitle">King's Field IV</div>
							<img id="crest-rule" src="rule_centred.alpha"/>
						</div>
						<div id="tabs"></div>
						<div id="version"></div>
					</div>
					<div id="content">
						<div id="heading"></div>
						<img id="heading-rule" src="rule_left.alpha"/>
						<div id="rows"></div>
					</div>
					<div id="help"></div>
				</div>
				<div id="prompts"></div>
			</div>
		</div>
		<img class="corner" id="corner-tl" src="corner_tl.alpha"/>
		<img class="corner" id="corner-tr" src="corner_tr.alpha"/>
		<img class="corner" id="corner-bl" src="corner_bl.alpha"/>
		<img class="corner" id="corner-br" src="corner_br.alpha"/>
	</div>
</body>
</rml>
