build/
*.o
*.a
*.map
build.ninja
objdiff.json
.ninja_log
.ninja_deps

# --- splat output: disassembly and data carved from the base ELF ---
asm/
config/undefined_*.txt
config/auto/

# --- Local toolchain / env ---
tools/cc/
.venv/
__pycache__/
*.pyc
.vscode/
.idea/
*.swp
.splache

# --- PC port build output ---
out/

