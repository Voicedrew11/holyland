# Game data + derived artifacts: never commit these.
# The user supplies their own disc image and the toolchain regenerates the rest.
# The per-game deliverable is kfiv/ (config, function map, ELF hash).

# Disc images (any dump of the game); disc/ holds the user's own dump
disc/*
!disc/README.md
*.iso
*.ISO
*.bin
*.BIN
*.img
*.IMG
*.chd
*.CHD
*.cso
*.CSO

# Extracted PS2 executables (boot ELF is named after the serial, no extension)
SLUS_*
SLES_*
SLPS_*
SLPM_*
SCUS_*
SCES_*
SCPS_*
# ...except the committed per-game data, which shares the serial prefix.
!kfiv/SLUS_*.csv
!kfiv/SLUS_*.sha256
*.elf
*.ELF

# Recompiler output: generated C++ (disposable, regenerated by 03-recompile.sh)
output/
*_output/

# Runner build trees (PS2Recomp clone + CMake build, disposable)
_build/
out/
build/
test-builds/
scripts/windows/runs/

# Emulated memory cards + local game data dirs
mc0/
mc1/
kfiv-data/
.ps2recomp-games/

# Ghidra projects (slow to rebuild, keep locally, never commit)
ghidra_project/
*.gpr
*.gpg

# Local notes / hashes that may reference personal paths
game.properties
*.log
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*~
.vscode/
.idea/

# Runtime traces
ps2_log.txt
*_log.txt
