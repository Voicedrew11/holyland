# --- Never commit game data: disc images, executables, extracted files ---
*.iso
*.bin
# (the PC renderer's pipeline seed: renderer state, none of the game's data, tools/pipeline_seed.py)
!port/gs/pc/pipeline_seed.bin
*.cue
*.chd
# (iso9660_test's CHDs: a 24-sector image the test makes itself, none of the game's data; tests/iso9660_test.c)
!tests/data/*.chd
*.elf
*.irx
*.rom
SLUS_*
SLUS-*
SLPS_*
SLES_*
SYSTEM.CNF
baserom/
assets/

# --- Build output (contains disc-derived bytes) ---
build/
*.o
*.a
*.map
!third_party/vk-sync2-layer/extension-layer/layers/libVkLayer_khronos_synchronization2.map
build.ninja
objdiff.json
.ninja_log
.ninja_deps

# --- splat output: disassembly and data carved from the base ELF ---
asm/
config/undefined_*.txt
config/auto/

# --- Local toolchain / env ---
tools/cc/
.venv/
__pycache__/
*.pyc
.vscode/
.idea/
*.swp
.splache

# --- PC port build output ---
out/

# --- tools/patches.py working copy ---
work/
dist/
