# Every edit Darker Reality makes to Granite (third_party/parallel-gs/Granite), in order: the game's configure makes them
# (CMakeLists.txt), and so does a release's packaging (packaging/payload.sh, through cmake/apply_granite_edits.cmake),
# whose source is then read-only on the player's computer. Each edit is made once: a checkout that has it is left alone.
set(KF4_GRANITE_EDITS_DIR ${CMAKE_CURRENT_LIST_DIR}) # (inside the function, CMAKE_CURRENT_LIST_DIR is the caller's)

function(kf4_granite_edits granite)
    # Granite with the depth bounds test (cmake/granite_depth_bounds.cmake: made in its checkout)
    include(${KF4_GRANITE_EDITS_DIR}/granite_depth_bounds.cmake)
    kf4_granite_depth_bounds(${granite})
    # and with dynamic state for the PC renderer's draws (cmake/granite_dynamic_state.cmake, after the above)
    include(${KF4_GRANITE_EDITS_DIR}/granite_dynamic_state.cmake)
    kf4_granite_dynamic_state(${granite})
    # and with the hooks of the pipeline list (cmake/granite_pipeline_warm.cmake, after the above)
    include(${KF4_GRANITE_EDITS_DIR}/granite_pipeline_warm.cmake)
    kf4_granite_pipeline_warm(${granite})
    kf4_granite_pipeline_cache_locks(${granite})
    # and with a render pass's samples in its hash (cmake/granite_msaa.cmake: from the PC renderer's MSAA, removed; kept as a fix)
    include(${KF4_GRANITE_EDITS_DIR}/granite_msaa.cmake)
    kf4_granite_msaa(${granite})
    # and with an image's first layout transition visible to what follows (cmake/granite_layout_sync.cmake)
    include(${KF4_GRANITE_EDITS_DIR}/granite_layout_sync.cmake)
    kf4_granite_layout_sync(${granite})
    # and with a buffer bound again unchanged keeping its descriptor set (cmake/granite_descriptor_reuse.cmake)
    include(${KF4_GRANITE_EDITS_DIR}/granite_descriptor_reuse.cmake)
    kf4_granite_descriptor_reuse(${granite})
    # and with a frame context moved on only when no command buffer is open (cmake/granite_try_frame_context.cmake)
    include(${KF4_GRANITE_EDITS_DIR}/granite_try_frame_context.cmake)
    kf4_granite_try_frame_context(${granite})
    # and with the GPU's work of the next frame context waited for without the device lock
    # (cmake/granite_frame_context_wait.cmake, after the above)
    include(${KF4_GRANITE_EDITS_DIR}/granite_frame_context_wait.cmake)
    kf4_granite_frame_context_wait(${granite})
    # and with fragment shader interlock (cmake/granite_interlock.cmake: the PC renderer's depth rule)
    include(${KF4_GRANITE_EDITS_DIR}/granite_interlock.cmake)
    kf4_granite_interlock(${granite})
endfunction()
