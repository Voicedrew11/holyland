<rml>
<head>
	<title>Holyland</title>
	<link type="text/rcss" href="launcher.rcss"/>
</head>
<body>
	<!-- the menu's window: its frame and iron corners (launcher.rcss) -->
	<div id="frame">
		<div></div>
		<img class="corner" id="corner-tl" src="corner_tl.alpha"/>
		<img class="corner" id="corner-tr" src="corner_tr.alpha"/>
		<img class="corner" id="corner-bl" src="corner_bl.alpha"/>
		<img class="corner" id="corner-br" src="corner_br.alpha"/>
	</div>
	<div id="update"></div>
	<img id="logo" src="logo.alpha"/>
	<p id="disc" class="dim"></p>
	<p id="built" class="dim"></p>
	<div class="buttons">
		<span class="button main" data-action="play">Play</span>
		<span class="button" data-action="change-disc">Change disc</span>
		<span class="button" data-action="rebuild">Rebuild</span>
		<span class="button" data-action="open-folder">Open data folder</span>
	</div>
	<span id="updates-check" class="link" data-action="toggle-updates"></span>
	<div id="foot"><span id="version"></span></div>
</body>
</rml>
