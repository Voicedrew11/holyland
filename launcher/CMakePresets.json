{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../out/launcher-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    { "name": "linux", "inherits": "base", "displayName": "The launcher on Linux" },
    { "name": "windows", "inherits": "base", "displayName": "The launcher on Windows (llvm-mingw)" }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows", "configurePreset": "windows" }
  ]
}
